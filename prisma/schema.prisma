// SkillLink — схема базы данных.
// Источник истины: docs/DATABASE_SCHEMA.md и раздел 11 ТЗ продукта (docs/tz/skilllink-tz.md).
// JSON наружу — camelCase, в базе snake_case через @map / @@map.
// Схема меняется только новой миграцией в prisma/migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Перечисления ───────────────────────────────

/// Роли из раздела 5 ТЗ плюс UNIVERSITY_REP из концепции (кабинет вуза, P1).
enum UserRole {
  ADMIN
  MANAGER
  ANALYST
  VIEWER
  UNIVERSITY_REP
}

/// Перечень статусов взаимодействия с вузом — утверждено заказчиком 26.09.2026.
enum UniversityStatus {
  NEW
  IN_PROGRESS
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ProgramLevel {
  SPO
  BACHELOR
  SPECIALIST
  MASTER
  POSTGRADUATE
  DPO
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SkillLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum SkillImportance {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Происхождение данных. Нужно, чтобы показатель всегда был объяснимым (раздел 10 ТЗ).
enum DataOrigin {
  CURRICULUM
  EXPERT
  INTEGRATION
  IMPORT
  MANUAL
  MOCK
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum ProductStatus {
  PLANNED
  ACTIVE
  DEPRECATED
}

enum ProductSkillRelevance {
  CORE
  RELATED
  OPTIONAL
}

enum CooperationStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

/// Фазы конвейера из концепции. Контроль (этап 14) вынесен отдельной фазой.
enum StagePhase {
  ATTRACTION
  FORMALIZATION
  IMPLEMENTATION
  OPERATION
  CONTROL
}

enum DocumentType {
  NDA
  AGREEMENT
  ANNEX
  ACT
  LICENSE
  CURRICULUM
  METHODOLOGY
  OTHER
}

enum DocumentStatus {
  DRAFT
  REVIEW
  APPROVED
  SIGNED
  REJECTED
  ARCHIVED
}

enum MeetingFormat {
  ONLINE
  OFFLINE
  CALL
  CORRESPONDENCE
}

enum RecommendationType {
  PROGRAM
  UNIVERSITY
  SKILL
  ACTION
}

enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecommendationStatus {
  NEW
  IN_PROGRESS
  ACCEPTED
  DISMISSED
  DONE
}

enum DataSourceType {
  MANUAL
  CSV
  EXTERNAL_API
  LMS
  SITE
  MOCK
}

/// Заявка на обучение. Персональных данных обучающихся не содержит.
/// Состав полей заявки — рабочее значение, согласуется с заказчиком.
enum ApplicationStatus {
  NEW
  CONFIRMED
  ENROLLED
  REJECTED
  CANCELLED
}

/// Правовое основание обработки ПД контактного лица вуза (ч. 1 ст. 6 152-ФЗ, решение 111).
/// Основное для контактов — законный интерес по договору с вузом (docs/PRIVACY.md, раздел 3).
enum ContactLegalBasis {
  /// п. 7: законный интерес оператора — исполнение договора (соглашения) с вузом.
  LEGITIMATE_INTEREST
  /// п. 5: договор, стороной которого является сам субъект (не вуз).
  CONTRACT
  /// п. 1: согласие субъекта.
  CONSENT
  /// Иное основание ст. 6 — какое, видно по документу-основанию.
  OTHER
}

/// Статус согласия. NONE — основание не согласие; OBTAINED и WITHDRAWN — только при CONSENT.
enum ConsentStatus {
  NONE
  OBTAINED
  WITHDRAWN
}

/// Форма согласия (ч. 1 ст. 9: в любой форме, позволяющей подтвердить факт получения).
enum ConsentForm {
  WRITTEN
  ELECTRONIC
  ORAL_CONFIRMED_BY_EMAIL
}

// ──────────────────────────── Пользователи и доступ ─────────────────────────

/// Сотрудник ИТ-Школы или представитель вуза. У представителя заполнен universityId —
/// он ограничивает видимость его собственным вузом.
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  fullName       String   @map("full_name")
  position       String?
  role           UserRole @default(VIEWER)
  /// Заполнен только у UNIVERSITY_REP: ограничивает видимость своим вузом.
  universityId   String?  @map("university_id")
  /// P1: NextAuth.js + bcrypt. На P0 не используется (mock-авторизация через cookie).
  passwordHash   String?  @map("password_hash")
  isActive       Boolean  @default(true) @map("is_active")
  /// Версия сессий (решение 109): кладётся в JWT при входе и сверяется на каждый запрос.
  /// Растёт при смене и сбросе пароля, блокировке и смене роли — выданные раньше сессии
  /// перестают действовать. Токен без версии (выдан до миграции) считается версией 0.
  /// CHECK в базе (миграция user_session_version): session_version ≥ 0.
  sessionVersion Int      @default(0) @map("session_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  university             University?          @relation(fields: [universityId], references: [id], onDelete: SetNull)
  cooperations           Cooperation[]        @relation("CooperationResponsible")
  stagesResponsible      WorkflowStage[]      @relation("StageResponsible")
  stagesCompleted        WorkflowStage[]      @relation("StageCompletedBy")
  tasksDone              Task[]               @relation("TaskDoneBy")
  stageHistoryEntries    StageHistory[]       @relation("StageHistoryAuthor")
  documentsAuthored      Document[]           @relation("DocumentAuthor")
  documentsResponsible   Document[]           @relation("DocumentResponsible")
  documentHistoryEntries DocumentHistory[]    @relation("DocumentHistoryAuthor")
  meetingsResponsible    Meeting[]            @relation("MeetingResponsible")
  meetingParticipations  MeetingParticipant[] @relation("MeetingParticipantUser")
  recommendationsClosed  Recommendation[]     @relation("RecommendationResolver")
  auditLogs              AuditLog[]           @relation("AuditLogUser")
  applicationsCreated    Application[]        @relation("ApplicationAuthor")
  telegramLink           TelegramLink?
  calendarFeed           CalendarFeed?
  contactBasisChanges    ContactBasisHistory[] @relation("ContactBasisHistoryAuthor")
  duplicateDismissals    DuplicateDismissal[]  @relation("DuplicateDismissalAuthor")
  universityMerges       UniversityMerge[]     @relation("UniversityMergeAuthor")
  universityMergeUndos   UniversityMerge[]     @relation("UniversityMergeUndoAuthor")

  @@index([role])
  @@index([universityId])
  @@map("users")
}

// ──────────────────────────────── Справочники ───────────────────────────────

/// Вуз-партнёр. Не удаляется никогда, только архивируется: сотрудничество длится годами,
/// и история отношений — основная ценность системы.
/// CHECK в базе (миграция check_constraints): student_count, direction_count — NULL или ≥ 0.
model University {
  id             String           @id @default(cuid())
  name           String
  shortName      String?          @map("short_name")
  city           String
  region         String
  address        String?
  website        String?
  status         UniversityStatus @default(NEW)
  /// Количество направлений подготовки. null — данных нет (никогда не 0 «по умолчанию»).
  directionCount Int?             @map("direction_count")
  /// Общая численность обучающихся в вузе.
  studentCount   Int?             @map("student_count")
  description    String?
  /// ИНН организации (решение 124): 10 цифр, контрольная цифра проверяется при вводе.
  /// null — не заполнен. CHECK в базе: NULL или ровно 10 цифр.
  inn            String?
  /// ОГРН организации: 13 цифр. CHECK в базе: NULL или ровно 13 цифр.
  ogrn           String?
  /// Вуз слит в другой (решение 124): запись в архиве и ссылается на того, кто остался.
  /// Не удаляется — слияние можно отменить. CHECK: не на себя; только у архивной записи.
  mergedIntoId   String?          @map("merged_into_id")
  /// Демонстрационная запись. Фронт обязан показывать пометку.
  isMock         Boolean          @default(false) @map("is_mock")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  archivedAt     DateTime?        @map("archived_at")

  mergedInto   University?          @relation("UniversityMergedInto", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   University[]         @relation("UniversityMergedInto")
  contacts     Contact[]
  programs     EducationalProgram[]
  cooperations Cooperation[]
  documents    Document[]
  meetings     Meeting[]
  applications Application[]
  users        User[]
  mergesAsSource UniversityMerge[] @relation("UniversityMergeSource")
  mergesAsTarget UniversityMerge[] @relation("UniversityMergeTarget")

  @@index([status])
  @@index([region])
  @@index([city])
  @@index([mergedIntoId])
  @@index([inn])
  /// Поиск дублей по названию (решение 124): кандидатов отбирает оператор `%` расширения pg_trgm.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "universities_name_trgm")
  @@map("universities")
}

/// Контактное лицо вуза. Минимум персональных данных: ФИО, должность, рабочие контакты.
model Contact {
  id           String   @id @default(cuid())
  universityId String   @map("university_id")
  fullName     String   @map("full_name")
  position     String?
  email        String?
  phone        String?
  isPrimary    Boolean  @default(false) @map("is_primary")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  /// Правовое основание обработки (решение 111). null — ещё не зафиксировано.
  legalBasis          ContactLegalBasis? @map("legal_basis")
  consentStatus       ConsentStatus      @default(NONE) @map("consent_status")
  /// Дата и форма согласия — ровно при consentStatus OBTAINED или WITHDRAWN.
  consentObtainedAt   DateTime?          @map("consent_obtained_at")
  consentForm         ConsentForm?       @map("consent_form")
  /// Дата получения отзыва — ровно при WITHDRAWN. От неё идут 30 дней ч. 5 ст. 21.
  consentWithdrawnAt  DateTime?          @map("consent_withdrawn_at")
  /// Где лежит документ-основание: номер, дата, место хранения. Не файл и не ПД.
  basisReference      String?            @map("basis_reference")
  /// Где лежит отзыв согласия (входящий номер письма). Ровно при WITHDRAWN.
  withdrawalReference String?            @map("withdrawal_reference")
  /// Когда основание фиксировалось в последний раз; кто — в истории.
  basisUpdatedAt      DateTime?          @map("basis_updated_at")

  university     University           @relation(fields: [universityId], references: [id], onDelete: Cascade)
  participations MeetingParticipant[] @relation("MeetingParticipantContact")
  basisHistory   ContactBasisHistory[]

  @@index([universityId])
  /**
   * Единственность основного контакта обеспечена частичным уникальным индексом
   * `contacts_one_primary_per_university` — он создан в миграции вручную,
   * потому что условие `WHERE is_primary` в схеме Prisma не выражается.
   * Без него при двух основных контактах карточка вуза показывала бы произвольный:
   * она берёт первый найденный.
   *
   * CHECK в базе (миграция contact_legal_basis): статус согласия не NONE ровно
   * при основании CONSENT; дата и форма — ровно при OBTAINED/WITHDRAWN; дата
   * и документ отзыва — ровно при WITHDRAWN, отзыв не раньше получения;
   * документ-основание и дата фиксации — ровно при заданном основании.
   */
  @@map("contacts")
}

/// История основания обработки и согласия контакта (решение 111): кто, когда, что было → что стало.
/// Только коды, даты и признаки — ни комментария, ни текста документа-основания: история
/// переживает обезличивание контакта и служит выгрузкой для акта, ПД в ней быть не должно.
/// CHECK в базе: статус согласия не NONE ровно при to_basis = CONSENT.
model ContactBasisHistory {
  id                 String             @id @default(cuid())
  contactId          String             @map("contact_id")
  fromBasis          ContactLegalBasis? @map("from_basis")
  toBasis            ContactLegalBasis  @map("to_basis")
  fromConsentStatus  ConsentStatus      @map("from_consent_status")
  toConsentStatus    ConsentStatus      @map("to_consent_status")
  consentObtainedAt  DateTime?          @map("consent_obtained_at")
  consentForm        ConsentForm?       @map("consent_form")
  consentWithdrawnAt DateTime?          @map("consent_withdrawn_at")
  /// Изменился ли документ-основание или появился документ отзыва. Сам текст не копируется.
  referenceChanged   Boolean            @default(false) @map("reference_changed")
  /// Изменение повлекло обезличивание контакта (отзыв единственного основания).
  anonymized         Boolean            @default(false)
  changedById        String             @map("changed_by_id")
  changedAt          DateTime           @default(now()) @map("changed_at")

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  changedBy User    @relation("ContactBasisHistoryAuthor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([contactId, changedAt])
  @@index([changedById])
  @@map("contact_basis_history")
}

/// Образовательная программа вуза. Три показателя рейтинга (заявки, обучающиеся, группы)
/// допускают null: незаполненный показатель — это «нет данных», а не ноль.
/// CHECK в базе: три показателя — NULL или ≥ 0; duration_months — NULL или 1–120.
model EducationalProgram {
  id             String        @id @default(cuid())
  universityId   String        @map("university_id")
  name           String
  code           String?
  /// Направление подготовки / УГСН.
  direction      String?
  level          ProgramLevel
  /// Длительность обучения в месяцах. null — данных нет.
  durationMonths Int?          @map("duration_months")
  status         ProgramStatus @default(ACTIVE)

  /// Три показателя рейтинга: в балл программы входят только они. null означает «Нет данных», а не ноль.
  applicationCount Int?        @map("application_count")
  studentCount     Int?        @map("student_count")
  groupCount       Int?        @map("group_count")
  metricsSource    DataOrigin? @map("metrics_source")
  metricsUpdatedAt DateTime?   @map("metrics_updated_at")

  isMock     Boolean   @default(false) @map("is_mock")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  university   University     @relation(fields: [universityId], references: [id], onDelete: Restrict)
  skills       ProgramSkill[]
  cooperations Cooperation[]
  documents    Document[]
  meetings     Meeting[]
  applications Application[]

  @@index([universityId])
  @@index([level])
  @@index([status])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "educational_programs_name_trgm")
  @@map("educational_programs")
}

/// Навык как единый справочник: на него ссылаются и программы, и продукты, и рыночный спрос.
/// Только так их можно сопоставить между собой.
model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  programs ProgramSkill[]
  products ProductSkill[]
  demand   MarketDemand[]

  @@index([category])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "skills_name_trgm")
  /**
   * Уникальность названия без учёта регистра и пробелов держит индекс по выражению
   * `skills_name_key_ci` (миграция 20260925230100, решение 110): «ML Ops» и «MLOps»,
   * «Python» и «python» — один навык. Выражение повторяет `skillNameKey`
   * (src/modules/skills/skills.rules.ts): NFKC, нижний регистр по ICU, без пробельных
   * знаков. Индексы по выражению Prisma не описывает — он создан в миграции вручную;
   * `prisma migrate diff` его не видит и удалить не предлагает. Меняешь `skillNameKey` —
   * меняй индекс новой миграцией (`db:verify` сверяет их на примерах).
   */
  @@map("skills")
}

/// Какой навык и на каком уровне даёт программа. Уровень и важность нужны для расчёта
/// покрытия: навык, данный на базовом уровне, закрывает дефицит не полностью.
model ProgramSkill {
  id         String           @id @default(cuid())
  programId  String           @map("program_id")
  skillId    String           @map("skill_id")
  level      SkillLevel       @default(BASIC)
  importance SkillImportance  @default(MEDIUM)
  source     DataOrigin       @default(CURRICULUM)
  confidence ConfidenceLevel?
  comment    String?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  program EducationalProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  skill   Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([programId, skillId])
  @@index([skillId])
  @@map("program_skills")
}

/// Агрегированный показатель востребованности навыка.
/// Происхождение обязательно: source, period, confidence, isMock.
/// CHECK в базе: value ≥ 0.
model MarketDemand {
  id           String          @id @default(cuid())
  skillId      String          @map("skill_id")
  /// Период в формате YYYY-Qn или YYYY-MM.
  period       String
  value        Float
  unit         String          @default("vacancies")
  /**
   * Регион замера. Обязателен и по умолчанию «Россия».
   * Обязателен, потому что входит в уникальный ключ: в PostgreSQL NULL-ы
   * в уникальном ключе считаются различными, и два замера «по стране»
   * без региона перестали бы схлопываться — то есть уникальность
   * потеряла бы смысл ровно там, где она нужна. Федеральный уровень — это
   * тоже значение региона, а не его отсутствие.
   */
  region       String          @default("Россия")
  source       String
  dataSourceId String?         @map("data_source_id")
  confidence   ConfidenceLevel @default(LOW)
  isMock       Boolean         @default(true) @map("is_mock")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  skill      Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  dataSource DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)

  /**
   * Регион входит в ключ: у одного навыка за один период от одного источника
   * бывают замеры по разным регионам, и без региона в ключе второй
   * не записался бы вовсе.
   */
  @@unique([skillId, period, source, region])
  @@index([period])
  @@index([dataSourceId])
  @@map("market_demand")
}

/// IT-продукт РТК, который передаётся вузу. Версия важна: при выпуске новой
/// групповая операция ставит задачи во всех связках, где передана устаревшая.
model ITProduct {
  id               String        @id @default(cuid())
  name             String        @unique
  category         String
  description      String?
  documentationUrl String?       @map("documentation_url")
  version          String?
  status           ProductStatus @default(ACTIVE)
  isMock           Boolean       @default(false) @map("is_mock")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  skills       ProductSkill[]
  cooperations Cooperation[]

  @@index([category])
  @@index([status])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "it_products_name_trgm")
  @@map("it_products")
}

/// Какие навыки даёт продукт. По этой связи система предлагает продукт там,
/// где у программы обнаружен дефицит навыка.
model ProductSkill {
  id        String                @id @default(cuid())
  productId String                @map("product_id")
  skillId   String                @map("skill_id")
  relevance ProductSkillRelevance @default(RELATED)
  createdAt DateTime              @default(now()) @map("created_at")

  product ITProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  skill   Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([productId, skillId])
  @@index([skillId])
  @@map("product_skills")
}

// ───────────────────── Сотрудничество и workflow из 14 этапов ────────────────

/// Единица учёта: связка «вуз — программа — IT-продукт» (концепция).
model Cooperation {
  id            String            @id @default(cuid())
  universityId  String            @map("university_id")
  programId     String            @map("program_id")
  /// Продукт может быть не выбран на ранних этапах.
  /// Продукт при создании связки не обязателен — утверждено заказчиком 26.09.2026.
  productId     String?           @map("product_id")
  status        CooperationStatus @default(DRAFT)
  responsibleId String            @map("responsible_id")
  goal          String?
  notes         String?

  /// Контрольные даты. Нужны для метрик дашборда (раздел 7.1 ТЗ).
  firstContactAt DateTime? @map("first_contact_at")
  classesStartAt DateTime? @map("classes_start_at")
  targetDate     DateTime? @map("target_date")
  startedAt      DateTime? @map("started_at")
  closedAt       DateTime? @map("closed_at")

  isMock    Boolean  @default(false) @map("is_mock")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  university      University         @relation(fields: [universityId], references: [id], onDelete: Restrict)
  program         EducationalProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  product         ITProduct?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  responsible     User               @relation("CooperationResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  stages          WorkflowStage[]
  documents       Document[]
  meetings        Meeting[]
  recommendations Recommendation[]

  @@index([universityId])
  @@index([programId])
  @@index([productId])
  @@index([status])
  @@index([responsibleId])
  @@map("cooperations")
}

/// Один из 14 этапов конвейера. Создаются все сразу при заведении связки.
/// title хранится копией: история не должна меняться задним числом при правке настроек.
/// CHECK в базе: stage_number 1–14; COMPLETED — с результатом (кроме этапа 14);
/// BLOCKED — с причиной.
model WorkflowStage {
  id             String      @id @default(cuid())
  cooperationId  String      @map("cooperation_id")
  /// 1..14 по разделу 8 ТЗ.
  stageNumber    Int         @map("stage_number")
  /// Копия названия на момент создания: история не должна зависеть от конфига.
  title          String
  phase          StagePhase
  status         StageStatus @default(NOT_STARTED)
  responsibleId  String?     @map("responsible_id")
  deadline       DateTime?
  comment        String?
  result         String?
  blockingReason String?     @map("blocking_reason")
  startedAt      DateTime?   @map("started_at")
  completedAt    DateTime?   @map("completed_at")
  completedById  String?     @map("completed_by_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  cooperation Cooperation    @relation(fields: [cooperationId], references: [id], onDelete: Cascade)
  responsible User?          @relation("StageResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  completedBy User?          @relation("StageCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  tasks       Task[]
  history     StageHistory[]

  @@unique([cooperationId, stageNumber])
  @@index([status])
  @@index([deadline])
  /**
   * Выборка этапов по ответственному сотруднику.
   */
  @@index([responsibleId])
  @@index([completedById])
  @@map("workflow_stages")
}

/// Пункт чек-листа этапа. Состав пунктов по этапам — в src/shared/config/workflow.config.ts.
/// CHECK в базе: sort_order ≥ 0.
model Task {
  id               String    @id @default(cuid())
  stageId          String    @map("stage_id")
  title            String
  /// Обязательные пункты блокируют перевод этапа в COMPLETED.
  isRequired       Boolean   @default(false) @map("is_required")
  isDone           Boolean   @default(false) @map("is_done")
  doneAt           DateTime? @map("done_at")
  doneById         String?   @map("done_by_id")
  /// Пункт отмечает вуз («Вуз подтвердил получение материалов», решение 103). Переносится из конфига.
  isUniversityItem Boolean   @default(false) @map("is_university_item")
  /// Чем подтверждено, если пункт вуза отметил сотрудник (решение 103). Есть только у отмеченного
  /// пункта вуза, со снятием отметки стирается. CHECK tasks_confirmation_note_check — в миграции.
  confirmationNote String?   @map("confirmation_note")
  sortOrder        Int       @default(0) @map("sort_order")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  stage  WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  doneBy User?         @relation("TaskDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  @@index([stageId])
  @@index([doneById])
  @@map("tasks")
}

/// История изменений этапа: каждое изменение статуса с автором и временем.
model StageHistory {
  id          String       @id @default(cuid())
  stageId     String       @map("stage_id")
  fromStatus  StageStatus? @map("from_status")
  toStatus    StageStatus  @map("to_status")
  comment     String?
  changedById String       @map("changed_by_id")
  changedAt   DateTime     @default(now()) @map("changed_at")

  stage     WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  changedBy User          @relation("StageHistoryAuthor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([stageId])
  @@index([changedAt])
  @@index([changedById])
  @@map("stage_history")
}

// ────────────────────────── Документы и встречи (P1) ────────────────────────

/// В MVP хранятся метаданные и ссылка. Загрузка файлов — P2.
model Document {
  id            String         @id @default(cuid())
  cooperationId String?        @map("cooperation_id")
  universityId  String?        @map("university_id")
  programId     String?        @map("program_id")
  type          DocumentType
  title         String
  version       String         @default("1")
  status        DocumentStatus @default(DRAFT)
  /// Текст, собранный из шаблона с подстановкой реквизитов (концепция).
  /// Это текст, а не файл: загрузка файлов остаётся P2.
  content       String?
  /// Ключ шаблона, из которого собран документ. null — документ заведён вручную.
  templateKey   String?        @map("template_key")
  fileReference String?        @map("file_reference")
  authorId      String?        @map("author_id")
  responsibleId String?        @map("responsible_id")
  issuedAt      DateTime?      @map("issued_at")
  signedAt      DateTime?      @map("signed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  cooperation Cooperation?        @relation(fields: [cooperationId], references: [id], onDelete: Cascade)
  university  University?         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  program     EducationalProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)
  author      User?               @relation("DocumentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  responsible User?               @relation("DocumentResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  history     DocumentHistory[]

  @@index([cooperationId])
  @@index([universityId])
  @@index([status])
  @@index([programId])
  @@index([authorId])
  @@index([responsibleId])
  @@map("documents")
}

/// Изменения статуса документа с автором и временем. Нужна, чтобы путь документа
/// от черновика до подписи можно было восстановить.
model DocumentHistory {
  id          String          @id @default(cuid())
  documentId  String          @map("document_id")
  fromStatus  DocumentStatus? @map("from_status")
  toStatus    DocumentStatus  @map("to_status")
  comment     String?
  changedById String          @map("changed_by_id")
  changedAt   DateTime        @default(now()) @map("changed_at")

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  changedBy User     @relation("DocumentHistoryAuthor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([changedAt])
  @@index([changedById])
  @@map("document_history")
}

/// Встреча с вузом: результат и следующее действие со сроком. Хранится отдельно
/// от этапов, потому что встречи бывают и вне конвейера.
model Meeting {
  id              String        @id @default(cuid())
  cooperationId   String?       @map("cooperation_id")
  universityId    String?       @map("university_id")
  programId       String?       @map("program_id")
  date            DateTime
  topic           String
  format          MeetingFormat @default(ONLINE)
  result          String?
  nextAction      String?       @map("next_action")
  nextActionDueAt DateTime?     @map("next_action_due_at")
  responsibleId   String        @map("responsible_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  cooperation  Cooperation?         @relation(fields: [cooperationId], references: [id], onDelete: Cascade)
  university   University?          @relation(fields: [universityId], references: [id], onDelete: Cascade)
  program      EducationalProgram?  @relation(fields: [programId], references: [id], onDelete: Cascade)
  responsible  User                 @relation("MeetingResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  participants MeetingParticipant[]

  @@index([cooperationId])
  @@index([universityId])
  @@index([date])
  @@index([programId])
  @@index([responsibleId])
  @@map("meetings")
}

/// Участник встречи: сотрудник, контактное лицо вуза или человек со стороны,
/// которого нет ни там ни там — для него externalName.
model MeetingParticipant {
  id           String   @id @default(cuid())
  meetingId    String   @map("meeting_id")
  userId       String?  @map("user_id")
  contactId    String?  @map("contact_id")
  /// Для участника, которого нет ни в пользователях, ни в контактах.
  externalName String?  @map("external_name")
  createdAt    DateTime @default(now()) @map("created_at")

  meeting Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User?    @relation("MeetingParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  contact Contact? @relation("MeetingParticipantContact", fields: [contactId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([userId])
  @@index([contactId])
  @@map("meeting_participants")
}

// ────────────────── Рекомендации, источники, журнал, заявки ─────────────────

/// Подсказка системы с обязательным обоснованием. Уникальна по тройке
/// «правило + объект»: повторная генерация обновляет, а не плодит дубли.
model Recommendation {
  id                String                 @id @default(cuid())
  type              RecommendationType
  /// Тип и идентификатор объекта, к которому относится рекомендация.
  objectType        String                 @map("object_type")
  objectId          String                 @map("object_id")
  /// Ключ правила, которое породило рекомендацию. Нужен для повторной генерации без дублей.
  ruleKey           String                 @map("rule_key")
  title             String
  description       String
  priority          RecommendationPriority @default(MEDIUM)
  /// Человекочитаемое основание: почему система это предлагает.
  justification     String
  /// Связанные данные для раскрытия основания на фронте.
  relatedData       Json?                  @map("related_data")
  confidence        ConfidenceLevel        @default(MEDIUM)
  status            RecommendationStatus   @default(NEW)
  /// Комментарий сотрудника при закрытии или отклонении.
  /// Отдельно от justification: то — обоснование системы, это — решение человека.
  resolutionComment String?                @map("resolution_comment")
  cooperationId     String?                @map("cooperation_id")
  resolvedById      String?                @map("resolved_by_id")
  resolvedAt        DateTime?              @map("resolved_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  cooperation Cooperation? @relation(fields: [cooperationId], references: [id], onDelete: Cascade)
  resolvedBy  User?        @relation("RecommendationResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([ruleKey, objectType, objectId])
  @@index([status, priority])
  @@index([type])
  /**
   * Поиск рекомендаций по объекту. Уникальный ключ выше для этого не годится:
   * его ведущая колонка — ruleKey, и запрос без неё читал бы таблицу
   * целиком.
   */
  @@index([objectType, objectId])
  @@index([cooperationId])
  @@index([resolvedById])
  @@map("recommendations")
}

/// Источник рыночных данных с оценкой достоверности. Без него показатель
/// нельзя подписать происхождением, а показатель должен быть объяснимым (раздел 10 ТЗ).
model DataSource {
  id             String          @id @default(cuid())
  name           String          @unique
  type           DataSourceType
  url            String?
  collectionDate DateTime?       @map("collection_date")
  reliability    ConfidenceLevel @default(LOW)
  description    String?
  isMock         Boolean         @default(true) @map("is_mock")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  demand MarketDemand[]

  @@map("data_sources")
}

/// Журнал критичных действий (раздел 15 ТЗ). Персональные данные в payload не пишутся.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  objectType String   @map("object_type")
  objectId   String   @map("object_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([objectType, objectId])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_log")
}

/// Личная подписка на календарь сроков и встреч (.ics, решение 105).
/// Одна на пользователя. Токен из ссылки в базе не хранится — только SHA-256 от него:
/// утёкшая копия базы не даёт открыть ни одну ленту. Перевыпуск заменяет хеш,
/// отзыв удаляет строку.
model CalendarFeed {
  userId    String   @id @map("user_id")
  /// SHA-256 от токена, шестнадцатеричный (64 знака).
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_feeds")
}

/// Заявка на обучение от вуза: applicationCount программы — сумма её заявок, кроме отменённых и отклонённых.
/// Персональных данных обучающихся не содержит.
/// CHECK в базе: quantity 1–10000.
model Application {
  id           String            @id @default(cuid())
  programId    String            @map("program_id")
  universityId String            @map("university_id")
  source       DataOrigin        @default(MANUAL)
  status       ApplicationStatus @default(NEW)
  /// Количество заявок в одной записи: вуз может внести пакет разом.
  quantity     Int               @default(1)
  comment      String?
  externalRef  String?           @map("external_ref")
  createdById  String?           @map("created_by_id")
  submittedAt  DateTime          @default(now()) @map("submitted_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  program    EducationalProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  university University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdBy  User?              @relation("ApplicationAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([programId])
  @@index([universityId])
  @@index([status])
  @@index([createdById])
  @@map("applications")
}

/// Привязка пользователя к личному чату Telegram (решение 102): туда приходит сводка
/// «что горит у меня». Один пользователь — один чат, один чат — один пользователь.
/// Хранится только то, без чего сообщение не доставить: идентификатор чата и ник,
/// чтобы человек в профиле узнал свой аккаунт. Удаляется вместе с пользователем
/// и командой /stop — истории у привязки нет и не нужно.
model TelegramLink {
  id       String   @id @default(cuid())
  userId   String   @unique @map("user_id")
  /// Идентификатор чата Telegram — целое до 52 бит, хранится строкой: в Int не влезает.
  chatId   String   @unique @map("chat_id")
  username String?
  linkedAt DateTime @default(now()) @map("linked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_links")
}

// ─────────────────────── Качество данных (решение 124) ───────────────────────

/// Пара записей, отмеченная «не дубль»: поиск дублей её больше не предлагает.
/// Пара хранится упорядоченной (first_id < second_id) — «A и B» и «B и A» одна запись.
/// Ссылок на сами записи нет: сущности разные (вуз, навык, программа, продукт);
/// исключение про удалённую запись просто ни на что не влияет.
/// CHECK в базе: entity — одна из четырёх; first_id < second_id.
model DuplicateDismissal {
  id            String   @id @default(cuid())
  entity        String
  firstId       String   @map("first_id")
  secondId      String   @map("second_id")
  comment       String?
  dismissedById String   @map("dismissed_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  dismissedBy User @relation("DuplicateDismissalAuthor", fields: [dismissedById], references: [id], onDelete: Restrict)

  @@unique([entity, firstId, secondId])
  @@index([dismissedById])
  @@map("duplicate_dismissals")
}

/// Слияние вуза-дубля в другой (решение 124). Журнал выживания полей и список
/// перенесённых объектов — чтобы слияние можно было объяснить и отменить.
/// В журнале только поля вуза и идентификаторы: ФИО и контакты не копируются.
/// CHECK в базе: source_id <> target_id; отменившего без даты отмены не бывает.
model UniversityMerge {
  id           String    @id @default(cuid())
  sourceId     String    @map("source_id")
  targetId     String    @map("target_id")
  mergedById   String    @map("merged_by_id")
  mergedAt     DateTime  @default(now()) @map("merged_at")
  /// До какого момента слияние можно отменить.
  undoUntil    DateTime  @map("undo_until")
  /// Правила выбора значения по полям: { поле: правило }.
  fieldRules   Json      @map("field_rules")
  /// Журнал выживания: по каждому полю — правило, чьё значение осталось, было и стало.
  survivorship Json
  /// Идентификаторы перенесённых объектов по таблицам — для отмены.
  moved        Json
  /// Состояние цели и источника до слияния — для отмены.
  before       Json
  undoneAt     DateTime? @map("undone_at")
  undoneById   String?   @map("undone_by_id")

  source   University @relation("UniversityMergeSource", fields: [sourceId], references: [id], onDelete: Restrict)
  target   University @relation("UniversityMergeTarget", fields: [targetId], references: [id], onDelete: Restrict)
  mergedBy User       @relation("UniversityMergeAuthor", fields: [mergedById], references: [id], onDelete: Restrict)
  undoneBy User?      @relation("UniversityMergeUndoAuthor", fields: [undoneById], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([targetId])
  @@index([mergedById])
  @@index([undoneById])
  @@map("university_merges")
}
