// SkillLink — схема базы данных.
// Источник истины: docs/DATABASE_SCHEMA.md и раздел 11 ТЗ продукта (docs/tz/skilllink-tz.md).
// JSON наружу — camelCase, в базе snake_case через @map / @@map.
// Схема меняется только новой миграцией в prisma/migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Перечисления ───────────────────────────────

/// Роли из раздела 5 ТЗ плюс UNIVERSITY_REP из концепции (кабинет вуза, P1).
enum UserRole {
  ADMIN
  MANAGER
  ANALYST
  VIEWER
  UNIVERSITY_REP
}

/// Перечень статусов взаимодействия с вузом — решение команды (PM) от 26.09.2026.
enum UniversityStatus {
  NEW
  IN_PROGRESS
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ProgramLevel {
  SPO
  BACHELOR
  SPECIALIST
  MASTER
  POSTGRADUATE
  DPO
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SkillLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum SkillImportance {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Происхождение данных. Нужно, чтобы показатель всегда был объяснимым (раздел 10 ТЗ).
enum DataOrigin {
  CURRICULUM
  EXPERT
  INTEGRATION
  IMPORT
  MANUAL
  MOCK
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum ProductStatus {
  PLANNED
  ACTIVE
  DEPRECATED
}

enum ProductSkillRelevance {
  CORE
  RELATED
  OPTIONAL
}

enum CooperationStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

/// Статус передачи ПО вузу — «Каталог по ТЗ» (решение 145, функц. требования, каталог).
enum TransferStatus {
  NOT_TRANSFERRED
  IN_PROGRESS
  TRANSFERRED
  REVOKED
}

/// К какой записи прикреплён файл (решение 145, ТЗ п.3 функц. требований: форматы вложений).
enum AttachmentOwnerType {
  DOCUMENT
  STAGE
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

/// Фазы конвейера из концепции. Контроль (этап 14) вынесен отдельной фазой.
enum StagePhase {
  ATTRACTION
  FORMALIZATION
  IMPLEMENTATION
  OPERATION
  CONTROL
}

enum DocumentType {
  NDA
  AGREEMENT
  ANNEX
  ACT
  LICENSE
  CURRICULUM
  METHODOLOGY
  OTHER
}

enum DocumentStatus {
  DRAFT
  REVIEW
  APPROVED
  SIGNED
  REJECTED
  ARCHIVED
}

enum MeetingFormat {
  ONLINE
  OFFLINE
  CALL
  CORRESPONDENCE
}

enum RecommendationType {
  PROGRAM
  UNIVERSITY
  SKILL
  ACTION
}

enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecommendationStatus {
  NEW
  IN_PROGRESS
  ACCEPTED
  DISMISSED
  DONE
}

/// Итог обучения модели прогноза по воротам публикации (решение 135, forecast.config.ts).
enum ForecastModelStatus {
  PUBLISHED
  BASELINE_BETTER
  INSUFFICIENT_DATA
}

/// Группа сигнала в проверке рекомендаций (решение 126): рекомендацию показали
/// сотруднику (treatment) или придержали для сравнения (control).
enum ExperimentArm {
  treatment
  control
}

enum DataSourceType {
  MANUAL
  CSV
  EXTERNAL_API
  LMS
  SITE
  MOCK
}

/// Заявка на обучение. Персональных данных обучающихся не содержит.
/// Состав полей заявки — рабочее значение, согласуется с заказчиком.
enum ApplicationStatus {
  NEW
  CONFIRMED
  ENROLLED
  REJECTED
  CANCELLED
}

/// Правовое основание обработки ПД контактного лица вуза (ч. 1 ст. 6 152-ФЗ, решение 111).
/// Основное для контактов — законный интерес по договору с вузом (docs/PRIVACY.md, раздел 3).
enum ContactLegalBasis {
  /// п. 7: законный интерес оператора — исполнение договора (соглашения) с вузом.
  LEGITIMATE_INTEREST
  /// п. 5: договор, стороной которого является сам субъект (не вуз).
  CONTRACT
  /// п. 1: согласие субъекта.
  CONSENT
  /// Иное основание ст. 6 — какое, видно по документу-основанию.
  OTHER
}

/// Предпочтительный канал связи с контактом вендора (решение 132).
enum VendorContactChannel {
  EMAIL
  TELEGRAM
  PHONE
}

/// Статус согласия. NONE — основание не согласие; OBTAINED и WITHDRAWN — только при CONSENT.
enum ConsentStatus {
  NONE
  OBTAINED
  WITHDRAWN
}

/// Форма согласия (ч. 1 ст. 9: в любой форме, позволяющей подтвердить факт получения).
enum ConsentForm {
  WRITTEN
  ELECTRONIC
  ORAL_CONFIRMED_BY_EMAIL
}

/// Чьи это сведения в запросе субъекта (решение 116): пользователь системы или контакт вуза.
enum DsarSubjectType {
  USER
  CONTACT
}

/// Что просит субъект: сведения о своих ПД (ст. 14) или их уничтожение (ч. 3 ст. 20, ст. 21).
enum DsarRequestKind {
  EXPORT
  ERASE
}

/// Открыт — срок идёт; исполнен — выгрузка отдана или ПД обезличены.
enum DsarRequestStatus {
  OPEN
  COMPLETED
}

/// Откуда запрос: сам пользователь из кабинета, письмо субъекта, выгрузка администратора без письма.
enum DsarRequestChannel {
  SELF_SERVICE
  LETTER
  ADMIN
}

// ──────────────────────────── Пользователи и доступ ─────────────────────────

/// Сотрудник ИТ-Школы или представитель вуза. У представителя заполнен universityId —
/// он ограничивает видимость его собственным вузом.
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  fullName       String   @map("full_name")
  position       String?
  role           UserRole @default(VIEWER)
  /// Заполнен только у UNIVERSITY_REP: ограничивает видимость своим вузом.
  universityId   String?  @map("university_id")
  /// P1: NextAuth.js + bcrypt. На P0 не используется (mock-авторизация через cookie).
  passwordHash   String?  @map("password_hash")
  isActive       Boolean  @default(true) @map("is_active")
  /// Версия сессий (решение 109): кладётся в JWT при входе и сверяется на каждый запрос.
  /// Растёт при смене и сбросе пароля, блокировке и смене роли — выданные раньше сессии
  /// перестают действовать. Токен без версии (выдан до миграции) считается версией 0.
  /// CHECK в базе (миграция user_session_version): session_version ≥ 0.
  sessionVersion Int      @default(0) @map("session_version")
  /// Решение 139: время последнего просмотра ленты уведомлений — источник истины на сервере.
  /// Ставится `POST /api/notifications/seen`; `localStorage` на фронте остаётся быстрым кэшем,
  /// но не хранилищем — иначе прочитанность терялась при смене устройства или очистке хранилища.
  notificationsSeenAt DateTime? @map("notifications_seen_at")
  /// Основной канал уведомлений (решение 144): куда уходит сводка «что горит у меня»
  /// и оповещения владельцу, когда настроено и привязано несколько каналов. Пусто —
  /// выбирается первый настроенный и привязанный по порядку Telegram → MAX → VK.
  notifyChannel  NotifyChannelKind? @map("notify_channel")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  university             University?           @relation(fields: [universityId], references: [id], onDelete: SetNull)
  cooperations           Cooperation[]         @relation("CooperationResponsible")
  stagesResponsible      WorkflowStage[]       @relation("StageResponsible")
  stagesCompleted        WorkflowStage[]       @relation("StageCompletedBy")
  tasksDone              Task[]                @relation("TaskDoneBy")
  stageHistoryEntries    StageHistory[]        @relation("StageHistoryAuthor")
  documentsAuthored      Document[]            @relation("DocumentAuthor")
  documentsResponsible   Document[]            @relation("DocumentResponsible")
  documentHistoryEntries DocumentHistory[]     @relation("DocumentHistoryAuthor")
  meetingsResponsible    Meeting[]             @relation("MeetingResponsible")
  meetingParticipations  MeetingParticipant[]  @relation("MeetingParticipantUser")
  recommendationsClosed  Recommendation[]      @relation("RecommendationResolver")
  auditLogs              AuditLog[]            @relation("AuditLogUser")
  applicationsCreated    Application[]         @relation("ApplicationAuthor")
  telegramLink           TelegramLink?
  notificationChannelLinks NotificationChannelLink[]
  calendarFeed           CalendarFeed?
  contactBasisChanges    ContactBasisHistory[] @relation("ContactBasisHistoryAuthor")
  duplicateDismissals    DuplicateDismissal[]  @relation("DuplicateDismissalAuthor")
  universityMerges       UniversityMerge[]     @relation("UniversityMergeAuthor")
  universityMergeUndos   UniversityMerge[]     @relation("UniversityMergeUndoAuthor")
  siteOrdersImported     SiteOrder[]           @relation("SiteOrderImporter")
  secretsRotated         SystemSecret[]        @relation("SystemSecretRotatedBy")
  approvalsRequested     Approval[]            @relation("ApprovalRequestedBy")
  approvalsApproved      Approval[]            @relation("ApprovalApprovedBy")
  approvalsRejected      Approval[]            @relation("ApprovalRejectedBy")
  idempotencyKeys        IdempotencyKey[]
  dsarRequestsMade       DsarRequest[]         @relation("DsarRequestAuthor")
  attachmentsUploaded    Attachment[]          @relation("AttachmentUploader")

  @@index([role])
  @@index([universityId])
  @@map("users")
}

// ──────────────────────────────── Справочники ───────────────────────────────

/// Вуз-партнёр. Не удаляется никогда, только архивируется: сотрудничество длится годами,
/// и история отношений — основная ценность системы.
/// CHECK в базе (миграция check_constraints): student_count, direction_count — NULL или ≥ 0.
model University {
  id             String           @id @default(cuid())
  name           String
  shortName      String?          @map("short_name")
  city           String
  region         String
  address        String?
  website        String?
  status         UniversityStatus @default(NEW)
  /// Количество направлений подготовки. null — данных нет (никогда не 0 «по умолчанию»).
  directionCount Int?             @map("direction_count")
  /// Общая численность обучающихся в вузе.
  studentCount   Int?             @map("student_count")
  description    String?
  /// ИНН организации (решение 124): 10 цифр, контрольная цифра проверяется при вводе.
  /// null — не заполнен. CHECK в базе: NULL или ровно 10 цифр.
  inn            String?
  /// ОГРН организации: 13 цифр. CHECK в базе: NULL или ровно 13 цифр.
  ogrn           String?
  /// Вуз слит в другой (решение 124): запись в архиве и ссылается на того, кто остался.
  /// Не удаляется — слияние можно отменить. CHECK: не на себя; только у архивной записи.
  mergedIntoId   String?          @map("merged_into_id")
  /// Демонстрационная запись. Фронт обязан показывать пометку.
  isMock         Boolean          @default(false) @map("is_mock")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  archivedAt     DateTime?        @map("archived_at")

  mergedInto   University?          @relation("UniversityMergedInto", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   University[]         @relation("UniversityMergedInto")
  contacts     Contact[]
  programs     EducationalProgram[]
  cooperations Cooperation[]
  documents    Document[]
  meetings     Meeting[]
  applications Application[]
  users        User[]
  mergesAsSource UniversityMerge[] @relation("UniversityMergeSource")
  mergesAsTarget UniversityMerge[] @relation("UniversityMergeTarget")

  @@index([status])
  @@index([region])
  @@index([city])
  @@index([mergedIntoId])
  @@index([inn])
  /// Поиск дублей по названию (решение 124): кандидатов отбирает оператор `%` расширения pg_trgm.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "universities_name_trgm")
  @@map("universities")
}

/// Контактное лицо вуза. Минимум персональных данных: ФИО, должность, рабочие контакты.
model Contact {
  id           String   @id @default(cuid())
  universityId String   @map("university_id")
  fullName     String   @map("full_name")
  position     String?
  email        String?
  phone        String?
  isPrimary    Boolean  @default(false) @map("is_primary")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  /// Правовое основание обработки (решение 111). null — ещё не зафиксировано.
  legalBasis          ContactLegalBasis? @map("legal_basis")
  consentStatus       ConsentStatus      @default(NONE) @map("consent_status")
  /// Дата и форма согласия — ровно при consentStatus OBTAINED или WITHDRAWN.
  consentObtainedAt   DateTime?          @map("consent_obtained_at")
  consentForm         ConsentForm?       @map("consent_form")
  /// Дата получения отзыва — ровно при WITHDRAWN. От неё идут 30 дней ч. 5 ст. 21.
  consentWithdrawnAt  DateTime?          @map("consent_withdrawn_at")
  /// Где лежит документ-основание: номер, дата, место хранения. Не файл и не ПД.
  basisReference      String?            @map("basis_reference")
  /// Где лежит отзыв согласия (входящий номер письма). Ровно при WITHDRAWN.
  withdrawalReference String?            @map("withdrawal_reference")
  /// Когда основание фиксировалось в последний раз; кто — в истории.
  basisUpdatedAt      DateTime?          @map("basis_updated_at")
  /// Решение 123: редакция политики обработки ПД на момент согласия. Только при согласии.
  consentPolicyVersion String?           @map("consent_policy_version")
  /// Решение 123: SHA-256 (hex) текста согласия, под которым человек подписался; текст не хранится.
  consentTextHash     String?            @map("consent_text_hash")
  /// Решение 123: где получено согласие (встреча, письмо, подписание соглашения). Без ПД.
  consentContext      String?            @map("consent_context")

  university     University            @relation(fields: [universityId], references: [id], onDelete: Cascade)
  participations MeetingParticipant[]  @relation("MeetingParticipantContact")
  basisHistory   ContactBasisHistory[]

  @@index([universityId])
  /**
   * Единственность основного контакта обеспечена частичным уникальным индексом
   * `contacts_one_primary_per_university` — он создан в миграции вручную,
   * потому что условие `WHERE is_primary` в схеме Prisma не выражается.
   * Без него при двух основных контактах карточка вуза показывала бы произвольный:
   * она берёт первый найденный.
   * CHECK в базе (миграция contact_legal_basis): статус согласия не NONE ровно
   * при основании CONSENT; дата и форма — ровно при OBTAINED/WITHDRAWN; дата
   * и документ отзыва — ровно при WITHDRAWN, отзыв не раньше получения;
   * документ-основание и дата фиксации — ровно при заданном основании.
   */
  @@map("contacts")
}

/// История основания обработки и согласия контакта (решение 111): кто, когда, что было → что стало.
/// Только коды, даты и признаки — ни комментария, ни текста документа-основания: история
/// переживает обезличивание контакта и служит выгрузкой для акта, ПД в ней быть не должно.
/// CHECK в базе: статус согласия не NONE ровно при to_basis = CONSENT.
model ContactBasisHistory {
  id                 String             @id @default(cuid())
  contactId          String             @map("contact_id")
  fromBasis          ContactLegalBasis? @map("from_basis")
  toBasis            ContactLegalBasis  @map("to_basis")
  fromConsentStatus  ConsentStatus      @map("from_consent_status")
  toConsentStatus    ConsentStatus      @map("to_consent_status")
  consentObtainedAt  DateTime?          @map("consent_obtained_at")
  consentForm        ConsentForm?       @map("consent_form")
  consentWithdrawnAt DateTime?          @map("consent_withdrawn_at")
  /// Изменился ли документ-основание или появился документ отзыва. Сам текст не копируется.
  referenceChanged   Boolean            @default(false) @map("reference_changed")
  /// Изменение повлекло обезличивание контакта (отзыв единственного основания).
  anonymized         Boolean            @default(false)
  /// Решение 123: редакция политики и хеш текста согласия — снимок на момент записи.
  policyVersion      String?            @map("policy_version")
  consentTextHash    String?            @map("consent_text_hash")
  changedById        String             @map("changed_by_id")
  changedAt          DateTime           @default(now()) @map("changed_at")

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  changedBy User    @relation("ContactBasisHistoryAuthor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([contactId, changedAt])
  @@index([changedById])
  @@map("contact_basis_history")
}

/// Образовательная программа вуза. Три показателя рейтинга (заявки, обучающиеся, группы)
/// допускают null: незаполненный показатель — это «нет данных», а не ноль.
/// CHECK в базе: три показателя — NULL или ≥ 0; duration_months — NULL или 1–120.
model EducationalProgram {
  id             String        @id @default(cuid())
  universityId   String        @map("university_id")
  name           String
  code           String?
  /// Направление подготовки / УГСН.
  direction      String?
  level          ProgramLevel
  /// Длительность обучения в месяцах. null — данных нет.
  durationMonths Int?          @map("duration_months")
  status         ProgramStatus @default(ACTIVE)

  /// Три показателя рейтинга: в балл программы входят только они. null означает «Нет данных», а не ноль.
  applicationCount Int?        @map("application_count")
  studentCount     Int?        @map("student_count")
  groupCount       Int?        @map("group_count")
  metricsSource    DataOrigin? @map("metrics_source")
  metricsUpdatedAt DateTime?   @map("metrics_updated_at")

  isMock     Boolean   @default(false) @map("is_mock")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  university   University     @relation(fields: [universityId], references: [id], onDelete: Restrict)
  skills       ProgramSkill[]
  cooperations Cooperation[]
  documents    Document[]
  meetings     Meeting[]
  applications Application[]

  @@index([universityId])
  @@index([level])
  @@index([status])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "educational_programs_name_trgm")
  @@map("educational_programs")
}

/// Навык как единый справочник: на него ссылаются и программы, и продукты, и рыночный спрос.
/// Только так их можно сопоставить между собой.
model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  programs ProgramSkill[]
  products ProductSkill[]
  demand   MarketDemand[]

  @@index([category])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "skills_name_trgm")
  /**
   * Уникальность названия без учёта регистра и пробелов держит индекс по выражению
   * `skills_name_key_ci` (миграция 20260925230100, решение 110): «ML Ops» и «MLOps»,
   * «Python» и «python» — один навык. Выражение повторяет `skillNameKey`
   * (src/modules/skills/skills.rules.ts): NFKC, нижний регистр по ICU, без пробельных
   * знаков. Индексы по выражению Prisma не описывает — он создан в миграции вручную;
   * `prisma migrate diff` его не видит и удалить не предлагает. Меняешь `skillNameKey` —
   * меняй индекс новой миграцией (`db:verify` сверяет их на примерах).
   */
  @@map("skills")
}

/// Какой навык и на каком уровне даёт программа. Уровень и важность нужны для расчёта
/// покрытия: навык, данный на базовом уровне, закрывает дефицит не полностью.
model ProgramSkill {
  id         String           @id @default(cuid())
  programId  String           @map("program_id")
  skillId    String           @map("skill_id")
  level      SkillLevel       @default(BASIC)
  importance SkillImportance  @default(MEDIUM)
  source     DataOrigin       @default(CURRICULUM)
  confidence ConfidenceLevel?
  comment    String?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  program EducationalProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  skill   Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([programId, skillId])
  @@index([skillId])
  @@map("program_skills")
}

/// Агрегированный показатель востребованности навыка.
/// Происхождение обязательно: source, period, confidence, isMock.
/// CHECK в базе: value ≥ 0.
model MarketDemand {
  id           String          @id @default(cuid())
  skillId      String          @map("skill_id")
  /// Период в формате YYYY-Qn или YYYY-MM.
  period       String
  value        Float
  unit         String          @default("vacancies")
  /**
   * Регион замера. Обязателен и по умолчанию «Россия».
   * Обязателен, потому что входит в уникальный ключ: в PostgreSQL NULL-ы
   * в уникальном ключе считаются различными, и два замера «по стране»
   * без региона перестали бы схлопываться — то есть уникальность
   * потеряла бы смысл ровно там, где она нужна. Федеральный уровень — это
   * тоже значение региона, а не его отсутствие.
   */
  region       String          @default("Россия")
  source       String
  dataSourceId String?         @map("data_source_id")
  confidence   ConfidenceLevel @default(LOW)
  isMock       Boolean         @default(true) @map("is_mock")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  skill      Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  dataSource DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)

  /**
   * Регион входит в ключ: у одного навыка за один период от одного источника
   * бывают замеры по разным регионам, и без региона в ключе второй
   * не записался бы вовсе.
   */
  @@unique([skillId, period, source, region])
  @@index([period])
  @@index([dataSourceId])
  @@map("market_demand")
}

/// IT-продукт РТК, который передаётся вузу. Версия важна: при выпуске новой
/// групповая операция ставит задачи во всех связках, где передана устаревшая.
model ITProduct {
  id               String        @id @default(cuid())
  name             String        @unique
  category         String
  description      String?
  documentationUrl String?       @map("documentation_url")
  version          String?
  status           ProductStatus @default(ACTIVE)
  /// Компания-вендор (решение 132). null — вендор не указан; продукты до решения 132 — такие.
  vendorId         String?       @map("vendor_id")
  isMock           Boolean       @default(false) @map("is_mock")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  vendor         Vendor?                @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  skills         ProductSkill[]
  cooperations   Cooperation[]
  vendorContacts VendorContactProduct[]
  schoolCourses  SchoolCourse[]

  @@index([category])
  @@index([status])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "it_products_name_trgm")
  @@index([vendorId])
  @@map("it_products")
}

/// Какие навыки даёт продукт. По этой связи система предлагает продукт там,
/// где у программы обнаружен дефицит навыка.
model ProductSkill {
  id        String                @id @default(cuid())
  productId String                @map("product_id")
  skillId   String                @map("skill_id")
  relevance ProductSkillRelevance @default(RELATED)
  createdAt DateTime              @default(now()) @map("created_at")

  product ITProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  skill   Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([productId, skillId])
  @@index([skillId])
  @@map("product_skills")
}

// ──────────────────── Вендоры, курсы ИТ-Школы, заказы с сайта ────────────────

/// Компания-вендор IT-продуктов (решение 132): ООО «Базис», ООО «ТДата» и другие компании
/// группы. Название уникально по ключу `name_key` — `catalogNameKey` из
/// src/shared/utils/contacts.ts (NFKC, нижний регистр, без пробелов и кавычек): «ООО «Базис»»
/// и «ООО "Базис"» — одна компания. Ключ хранится колонкой, а не индексом по выражению
/// (как у навыков, решение 110): считает его только код, расходиться не с чем.
model Vendor {
  id        String   @id @default(cuid())
  name      String
  nameKey   String   @unique @map("name_key")
  isMock    Boolean  @default(false) @map("is_mock")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products ITProduct[]
  contacts VendorContact[]

  @@map("vendors")
}

/// Контактное лицо вендора — деловой контакт (решение 132, по аналогии с контактами вузов,
/// решение 111): основание по умолчанию — законный интерес оператора (п. 7 ч. 1 ст. 6 152-ФЗ).
/// Почта и телефон — только ролям с правом CONTACT_DETAILS (решение 106).
/// Телефон хранится в виде +7XXXXXXXXXX, почта — в нижнем регистре.
model VendorContact {
  id                String                 @id @default(cuid())
  vendorId          String                 @map("vendor_id")
  fullName          String                 @map("full_name")
  email             String?
  phone             String?
  preferredChannels VendorContactChannel[] @map("preferred_channels")
  legalBasis        ContactLegalBasis      @default(LEGITIMATE_INTEREST) @map("legal_basis")
  /// Где лежит основание: письмо вендора, договор, файл загрузки. Не файл и не ПД.
  basisReference    String?                @map("basis_reference")
  isMock            Boolean                @default(false) @map("is_mock")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  vendor   Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  products VendorContactProduct[]

  @@index([vendorId])
  @@map("vendor_contacts")
}

/// По каким продуктам вендора отвечает контакт: в файле вендоров контакт указан у строки продукта.
model VendorContactProduct {
  contactId String @map("contact_id")
  productId String @map("product_id")

  contact VendorContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  product ITProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([contactId, productId])
  @@index([productId])
  @@map("vendor_contact_products")
}

/// Курс ИТ-Школы, который продаётся на сайте (решение 132). Отдельная сущность, а не
/// программа вуза: заказ на сайте делает человек, а не вуз, и в рейтинг программ
/// (решения 7, 9, 22) заказы не входят. Курс может быть «на базе продукта» — productId.
/// Название уникально по `name_key` (тот же `catalogNameKey`).
model SchoolCourse {
  id          String   @id @default(cuid())
  name        String
  nameKey     String   @unique @map("name_key")
  productId   String?  @map("product_id")
  description String?
  isMock      Boolean  @default(false) @map("is_mock")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product ITProduct?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  streams CourseStream[]
  orders  SiteOrder[]

  @@index([productId])
  @@map("school_courses")
}

/// Поток (группа) курса: «Номер потока» из заказа с сайта. Заводится при загрузке заказов.
/// CHECK в базе (миграция vendors_site_orders): number ≥ 1.
model CourseStream {
  id        String    @id @default(cuid())
  courseId  String    @map("course_id")
  number    Int
  startsAt  DateTime? @map("starts_at")
  createdAt DateTime  @default(now()) @map("created_at")

  course SchoolCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orders SiteOrder[]

  @@unique([courseId, number])
  @@map("course_streams")
}

/// Заказ с сайта (решение 132). ФИО, телефона и почты слушателя здесь НЕТ: они живут
/// только в запросе загрузки и в файле для LMS. Для дедупликации — HMAC-SHA256 от
/// нормализованной почты и телефона с ключом ORDERS_HMAC_KEY (docs/PRIVACY.md).
/// CHECK в базе: хеши — 64 шестнадцатеричных знака, хотя бы один задан.
model SiteOrder {
  id            String    @id @default(cuid())
  /// Номер заявки сайта (ORD-<дата-время>-<код>) — ключ повторной загрузки.
  orderNo       String    @unique @map("order_no")
  courseId      String    @map("course_id")
  streamId      String?   @map("stream_id")
  emailHash     String?   @map("email_hash")
  phoneHash     String?   @map("phone_hash")
  /// Дата заказа из номера заявки; null — номер битый (месяц 17, секунды 69, 15 цифр).
  orderedAt     DateTime? @map("ordered_at")
  importedAt    DateTime  @default(now()) @map("imported_at")
  importBatchId String    @map("import_batch_id")
  importedById  String?   @map("imported_by_id")
  /// Когда слушатель ушёл в файл «Загрузка пользователей» для LMS; null — ещё не уходил.
  lmsExportedAt DateTime? @map("lms_exported_at")
  isMock        Boolean   @default(false) @map("is_mock")

  course     SchoolCourse  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  stream     CourseStream? @relation(fields: [streamId], references: [id], onDelete: SetNull)
  importedBy User?         @relation("SiteOrderImporter", fields: [importedById], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([streamId])
  @@index([emailHash])
  @@index([phoneHash])
  @@index([importBatchId])
  @@index([importedById])
  @@map("site_orders")
}

// ───────────────────── Сотрудничество и workflow из 14 этапов ────────────────

/// Единица учёта: связка «вуз — программа — IT-продукт» (концепция).
model Cooperation {
  id            String            @id @default(cuid())
  universityId  String            @map("university_id")
  programId     String            @map("program_id")
  /// Продукт может быть не выбран на ранних этапах.
  /// Продукт при создании связки не обязателен — решение команды (PM) от 26.09.2026.
  productId     String?           @map("product_id")
  status        CooperationStatus @default(DRAFT)
  responsibleId String            @map("responsible_id")
  goal          String?
  notes         String?

  /// Контрольные даты. Нужны для метрик дашборда (раздел 7.1 ТЗ).
  firstContactAt DateTime? @map("first_contact_at")
  classesStartAt DateTime? @map("classes_start_at")
  targetDate     DateTime? @map("target_date")
  startedAt      DateTime? @map("started_at")
  closedAt       DateTime? @map("closed_at")

  /// Каталог по ТЗ РТК (решение 145): поля из требуемых колонок каталога, которых не было
  /// в связке. Все необязательны — миграция без риска для существующих строк, заполняются
  /// по мере появления данных у менеджера, сид заполняет только часть связок.
  /// Номер договора — реквизит, не идентификатор системы (текстовый, может содержать буквы).
  contractNumber   String?        @map("contract_number")
  /// Дата подписания лицензии на IT-продукт (не путать с датой подписания договора —
  /// той служит `documents.signedAt` документа LICENSE).
  licenseSignedAt  DateTime?      @map("license_signed_at")
  /// Срок действия лицензии в годах. CHECK в базе: NULL или 1..10 (решение 145).
  licenseTermYears Int?           @map("license_term_years")
  /// Статус передачи ПО вузу по каталогу ТЗ. null — не заполнено (демо и старые связки).
  transferStatus   TransferStatus? @map("transfer_status")
  /// Комментарий к каталожной карточке связки — тот же смысл, что везде: свободный текст,
  /// который может содержать ПД третьих лиц (docs/PRIVACY.md, 2.1), в выгрузки уходит как есть,
  /// как `Cooperation.notes`.
  comment          String?

  isMock    Boolean  @default(false) @map("is_mock")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  university      University         @relation(fields: [universityId], references: [id], onDelete: Restrict)
  program         EducationalProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  product         ITProduct?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  responsible     User               @relation("CooperationResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  stages          WorkflowStage[]
  documents       Document[]
  meetings        Meeting[]
  recommendations Recommendation[]
  externalImportLinks ExternalImportLink[]

  @@index([universityId])
  @@index([programId])
  @@index([productId])
  @@index([status])
  @@index([responsibleId])
  @@map("cooperations")
}

/// Приём данных извне — сайт и LMS (решение 145, ТЗ функц. требования п.5: `POST
/// /api/import/external`). Ключ идемпотентности повторной загрузки — пара
/// (source, externalId): тот же запрос второй раз находит ту же связку вместо
/// создания дубля. `source` — свободная строка («site», «lms» и другое, что
/// подключат позже): реальный контракт с внешней стороной ещё не согласован
/// (сказано в самом ТЗ), заводить под него перечисление рано.
model ExternalImportLink {
  id            String   @id @default(cuid())
  source        String
  externalId    String   @map("external_id")
  cooperationId String   @map("cooperation_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cooperation Cooperation @relation(fields: [cooperationId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([cooperationId])
  @@map("external_import_links")
}

/// Один из 14 этапов конвейера. Создаются все сразу при заведении связки.
/// title хранится копией: история не должна меняться задним числом при правке настроек.
/// CHECK в базе: stage_number 1–14; COMPLETED — с результатом (кроме этапа 14);
/// BLOCKED — с причиной.
model WorkflowStage {
  id             String      @id @default(cuid())
  cooperationId  String      @map("cooperation_id")
  /// 1..14 по разделу 8 ТЗ.
  stageNumber    Int         @map("stage_number")
  /// Копия названия на момент создания: история не должна зависеть от конфига.
  title          String
  phase          StagePhase
  status         StageStatus @default(NOT_STARTED)
  responsibleId  String?     @map("responsible_id")
  deadline       DateTime?
  comment        String?
  result         String?
  blockingReason String?     @map("blocking_reason")
  startedAt      DateTime?   @map("started_at")
  completedAt    DateTime?   @map("completed_at")
  completedById  String?     @map("completed_by_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  cooperation Cooperation    @relation(fields: [cooperationId], references: [id], onDelete: Cascade)
  responsible User?          @relation("StageResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  completedBy User?          @relation("StageCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  tasks       Task[]
  history     StageHistory[]

  @@unique([cooperationId, stageNumber])
  @@index([status])
  @@index([deadline])
  /**
   * Выборка этапов по ответственному сотруднику.
   */
  @@index([responsibleId])
  @@index([completedById])
  @@map("workflow_stages")
}

/// Пункт чек-листа этапа. Состав пунктов по этапам — в src/shared/config/workflow.config.ts.
/// CHECK в базе: sort_order ≥ 0.
model Task {
  id               String    @id @default(cuid())
  stageId          String    @map("stage_id")
  title            String
  /// Обязательные пункты блокируют перевод этапа в COMPLETED.
  isRequired       Boolean   @default(false) @map("is_required")
  isDone           Boolean   @default(false) @map("is_done")
  doneAt           DateTime? @map("done_at")
  doneById         String?   @map("done_by_id")
  /// Пункт отмечает вуз («Вуз подтвердил получение материалов», решение 103). Переносится из конфига.
  isUniversityItem Boolean   @default(false) @map("is_university_item")
  /// Чем подтверждено, если пункт вуза отметил сотрудник (решение 103). Есть только у отмеченного
  /// пункта вуза, со снятием отметки стирается. CHECK tasks_confirmation_note_check — в миграции.
  confirmationNote String?   @map("confirmation_note")
  sortOrder        Int       @default(0) @map("sort_order")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  stage  WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  doneBy User?         @relation("TaskDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  @@index([stageId])
  @@index([doneById])
  @@map("tasks")
}

/// История изменений этапа: каждое изменение статуса с автором и временем.
model StageHistory {
  id          String       @id @default(cuid())
  stageId     String       @map("stage_id")
  fromStatus  StageStatus? @map("from_status")
  toStatus    StageStatus  @map("to_status")
  comment     String?
  changedById String       @map("changed_by_id")
  changedAt   DateTime     @default(now()) @map("changed_at")

  stage     WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  changedBy User          @relation("StageHistoryAuthor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([stageId])
  @@index([changedAt])
  @@index([changedById])
  @@map("stage_history")
}

// ────────────────────────── Документы и встречи (P1) ────────────────────────

/// Метаданные и ссылка на текст, собранный из шаблона; настоящие файлы (сканы, лицензии,
/// подписанные версии) прикладываются отдельно — модель `Attachment` (решение 145).
model Document {
  id            String         @id @default(cuid())
  cooperationId String?        @map("cooperation_id")
  universityId  String?        @map("university_id")
  programId     String?        @map("program_id")
  type          DocumentType
  title         String
  version       String         @default("1")
  status        DocumentStatus @default(DRAFT)
  /// Текст, собранный из шаблона с подстановкой реквизитов (концепция).
  /// Это текст, а не файл: загрузка файлов остаётся P2.
  content       String?
  /// Ключ шаблона, из которого собран документ. null — документ заведён вручную.
  templateKey   String?        @map("template_key")
  fileReference String?        @map("file_reference")
  authorId      String?        @map("author_id")
  responsibleId String?        @map("responsible_id")
  issuedAt      DateTime?      @map("issued_at")
  signedAt      DateTime?      @map("signed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  cooperation Cooperation?        @relation(fields: [cooperationId], references: [id], onDelete: Cascade)
  university  University?         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  program     EducationalProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)
  author      User?               @relation("DocumentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  responsible User?               @relation("DocumentResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  history     DocumentHistory[]

  @@index([cooperationId])
  @@index([universityId])
  @@index([status])
  @@index([programId])
  @@index([authorId])
  @@index([responsibleId])
  @@map("documents")
}

/// Изменения статуса документа с автором и временем. Нужна, чтобы путь документа
/// от черновика до подписи можно было восстановить.
model DocumentHistory {
  id          String          @id @default(cuid())
  documentId  String          @map("document_id")
  fromStatus  DocumentStatus? @map("from_status")
  toStatus    DocumentStatus  @map("to_status")
  comment     String?
  changedById String          @map("changed_by_id")
  changedAt   DateTime        @default(now()) @map("changed_at")

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  changedBy User     @relation("DocumentHistoryAuthor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([changedAt])
  @@index([changedById])
  @@map("document_history")
}

/// Файл, прикреплённый к документу или этапу (решение 145, ТЗ функц. требования п.3:
/// форматы png, jpeg, pdf, zip, gzip, rar, doc, docx, xls, xlsx).
///
/// Сам файл лежит на диске сервера (`UPLOADS_DIR`, том Docker), под случайным ключом
/// `storageKey` — не под `originalName`: оригинальное имя может содержать что угодно
/// (управляющие символы, чужой путь), а строка на диске обязана быть безопасной сама
/// по себе. `sha256` — контроль целостности и защита от подмены содержимого при том же
/// имени; `size` и `mime` — то, что прошло проверку при загрузке (расширение из списка ТЗ
/// И сигнатура файла, magic bytes), не то, что прислал браузер без проверки.
///
/// `ownerType`/`ownerId` — полиморфная связь без внешнего ключа (Document | WorkflowStage):
/// Prisma не поддерживает FK на «одна из двух таблиц», проверка существования владельца —
/// в сервисе перед созданием записи, права — как у изменения самого владельца.
/// Запись не удаляется при удалении владельца (владелец, документ и этап, тоже не удаляется
/// в этой системе — только меняет статус/архивируется), поэтому onDelete здесь не нужен.
///
/// CHECK в базе: size > 0 (миграция attachments).
model Attachment {
  id           String              @id @default(cuid())
  ownerType    AttachmentOwnerType @map("owner_type")
  ownerId      String              @map("owner_id")
  originalName String              @map("original_name")
  mime         String
  size         Int
  sha256       String
  storageKey   String              @map("storage_key")
  uploadedById String              @map("uploaded_by_id")
  uploadedAt   DateTime            @default(now()) @map("uploaded_at")

  uploadedBy User @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([ownerType, ownerId])
  @@index([uploadedById])
  @@map("attachments")
}

/// Встреча с вузом: результат и следующее действие со сроком. Хранится отдельно
/// от этапов, потому что встречи бывают и вне конвейера.
model Meeting {
  id              String        @id @default(cuid())
  cooperationId   String?       @map("cooperation_id")
  universityId    String?       @map("university_id")
  programId       String?       @map("program_id")
  date            DateTime
  topic           String
  format          MeetingFormat @default(ONLINE)
  result          String?
  nextAction      String?       @map("next_action")
  nextActionDueAt DateTime?     @map("next_action_due_at")
  responsibleId   String        @map("responsible_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  cooperation  Cooperation?         @relation(fields: [cooperationId], references: [id], onDelete: Cascade)
  university   University?          @relation(fields: [universityId], references: [id], onDelete: Cascade)
  program      EducationalProgram?  @relation(fields: [programId], references: [id], onDelete: Cascade)
  responsible  User                 @relation("MeetingResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  participants MeetingParticipant[]

  @@index([cooperationId])
  @@index([universityId])
  @@index([date])
  @@index([programId])
  @@index([responsibleId])
  @@map("meetings")
}

/// Участник встречи: сотрудник, контактное лицо вуза или человек со стороны,
/// которого нет ни там ни там — для него externalName.
model MeetingParticipant {
  id           String   @id @default(cuid())
  meetingId    String   @map("meeting_id")
  userId       String?  @map("user_id")
  contactId    String?  @map("contact_id")
  /// Для участника, которого нет ни в пользователях, ни в контактах.
  externalName String?  @map("external_name")
  createdAt    DateTime @default(now()) @map("created_at")

  meeting Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User?    @relation("MeetingParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  contact Contact? @relation("MeetingParticipantContact", fields: [contactId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([userId])
  @@index([contactId])
  @@map("meeting_participants")
}

// ────────────────── Рекомендации, источники, журнал, заявки ─────────────────

/// Подсказка системы с обязательным обоснованием. Уникальна по тройке
/// «правило + объект»: повторная генерация обновляет, а не плодит дубли.
model Recommendation {
  id                String                 @id @default(cuid())
  type              RecommendationType
  /// Тип и идентификатор объекта, к которому относится рекомендация.
  objectType        String                 @map("object_type")
  objectId          String                 @map("object_id")
  /// Ключ правила, которое породило рекомендацию. Нужен для повторной генерации без дублей.
  ruleKey           String                 @map("rule_key")
  title             String
  description       String
  priority          RecommendationPriority @default(MEDIUM)
  /// Человекочитаемое основание: почему система это предлагает.
  justification     String
  /// Связанные данные для раскрытия основания на фронте.
  relatedData       Json?                  @map("related_data")
  confidence        ConfidenceLevel        @default(MEDIUM)
  status            RecommendationStatus   @default(NEW)
  /// Комментарий сотрудника при закрытии или отклонении.
  /// Отдельно от justification: то — обоснование системы, это — решение человека.
  resolutionComment String?                @map("resolution_comment")
  cooperationId     String?                @map("cooperation_id")
  resolvedById      String?                @map("resolved_by_id")
  resolvedAt        DateTime?              @map("resolved_at")
  /// Решение 119. Итоговый балл 0..1: польза правила, ценность случая, приоритет.
  /// Пересчитывается у открытых рекомендаций после пересборки и каждого решения сотрудника.
  score             Float?
  /// Разбор балла: { p, pSource, trialsEff, successesEff, value, priority, score, … }.
  scoreBreakdown    Json?                  @map("score_breakdown")
  /// Причины: [{ code, pass, detail, facts }] — проверки правила и пометки обучения.
  reasons           Json?
  /// Отложена защитой от перегрузки менеджера: не удалена, стоит в конце ленты.
  isDeferred        Boolean                @default(false) @map("is_deferred")
  /// Последний показ — момент, когда рекомендация создана или открыта снова (показ в статистике правила).
  shownAt           DateTime?              @map("shown_at")
  /// Когда показ засчитан полезным; второй раз за один показ не засчитывается.
  successAt         DateTime?              @map("success_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  cooperation Cooperation? @relation(fields: [cooperationId], references: [id], onDelete: Cascade)
  resolvedBy  User?        @relation("RecommendationResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  signals     RecommendationSignal[]

  @@unique([ruleKey, objectType, objectId])
  @@index([status, priority])
  @@index([type])
  /**
   * Поиск рекомендаций по объекту. Уникальный ключ выше для этого не годится:
   * его ведущая колонка — ruleKey, и запрос без неё читал бы таблицу
   * целиком.
   */
  @@index([objectType, objectId])
  @@index([cooperationId])
  @@index([resolvedById])
  @@index([score])
  @@map("recommendations")
}

/// Модель прогноза «дойдёт ли связка до вехи» (решение 135, docs/FORECAST_MODEL.md).
/// Одна запись на веху (`milestoneStage`): новое обучение заменяет предыдущую — версия
/// растёт, история обучений не хранится, это агрегированные коэффициенты и метрики
/// качества, а не персональные данные (DSAR_NOT_PERSONAL, dsar.registry.ts).
/// Прогнозы для конкретных связок не хранятся — считаются на лету от этой записи.
/// CHECK в базе: coefficients заполнены, когда status = PUBLISHED.
model ForecastModel {
  id             String              @id @default(cuid())
  /// Номер этапа вехи, к которой обучена модель (FORECAST_MILESTONES).
  milestoneStage Int                 @map("milestone_stage")
  horizonDays    Int                 @map("horizon_days")
  /// Растёт при каждом обучении той же вехи — не привязан к количеству строк в таблице.
  version        Int
  status         ForecastModelStatus
  trainedAt      DateTime            @map("trained_at")
  /// auc, baselineAuc, brier, n, positives, calibration и остальное — ForecastMetrics.
  metrics        Json
  /// intercept и веса по признакам; null — модель не обучилась (недостаточно данных).
  coefficients   Json?
  /// Медианы этапов, статистика признаков (среднее, отклонение, квантили, PSI) и частоты правила.
  featureStats   Json                @map("feature_stats")
  createdAt      DateTime            @default(now()) @map("created_at")

  @@unique([milestoneStage])
  @@map("forecast_models")
}

/// Решение 119. Статистика правила рекомендаций: сколько раз показано и сколько
/// раз оказалось полезным — полные счётчики и «эффективные» с затуханием
/// (полураспад RECOMMENDATION_LEARNING.halfLifeDays). Уровни: общий
/// (scope_id = 'all'), вуз, менеджер. Пишется только одним запросом
/// INSERT … ON CONFLICT DO UPDATE (recommendations.stats.repo.ts), затухание
/// считается в SQL — параллельные события не теряются.
/// CHECK-ограничения (в SQL миграции 20260926120000_recommendation_learning):
/// recommendation_rule_stats_scope_type_check, recommendation_rule_stats_counts_check.
model RecommendationRuleStats {
  ruleType     String   @map("rule_type")
  /// 'global' | 'university' | 'manager'.
  scopeType    String   @map("scope_type")
  scopeId      String   @map("scope_id")
  trials       Int      @default(0)
  successes    Int      @default(0)
  trialsEff    Float    @default(0) @map("trials_eff")
  successesEff Float    @default(0) @map("successes_eff")
  /// Решение 143: TIMESTAMP(3) без пояса — как весь остальной schema.prisma
  /// (соглашение «приложение пишет UTC», миграция audit_hash_chain). Раньше
  /// была TIMESTAMPTZ(6) — единственная колонка с поясом в схеме.
  effUpdatedAt DateTime @map("eff_updated_at")

  @@id([ruleType, scopeType, scopeId])
  @@map("recommendation_rule_stats")
}

/// Источник рыночных данных с оценкой достоверности. Без него показатель
/// нельзя подписать происхождением, а показатель должен быть объяснимым (раздел 10 ТЗ).
/// Журнал сигналов правил рекомендаций — контрольная группа и оценка прироста (решение 126).
///
/// Сигнал — «правило сработало по объекту». Пишется всегда, даже если эксперимент
/// выключен. Группа назначается детерминированно по хешу (правило + объект + период):
/// control — рекомендацию сотруднику не показали, treatment — показали.
/// В оценку идут только назначенные по хешу (assigned_by = 'hash'), знаменатель —
/// все назначенные (принцип «по назначению»).
///
/// Ограничения только в SQL миграции 20260926000000_recommendation_signals:
/// recommendation_signals_arm_check — у контроля нет рекомендации и назначение только по хешу;
/// recommendation_signals_assigned_by_check — допустимые способы назначения.
/// Решение 143 (миграция 20260926200000_schema_review): recommendation_signals_outcome_check —
/// outcome_at и outcome заданы только вместе, исход не раньше срабатывания сигнала.
model RecommendationSignal {
  id               String        @id @default(cuid())
  /// Ключ правила (ruleKey рекомендации).
  ruleType         String        @map("rule_type")
  /// Объект правила: Cooperation, EducationalProgram, Skill.
  entityType       String        @map("entity_type")
  entityId         String        @map("entity_id")
  /// Период назначения: номер отрезка длиной H дней от 01.01.1970 UTC («30d-684»).
  /// Один сигнал на правило, объект и период.
  periodKey        String        @map("period_key")
  firedAt          DateTime      @map("fired_at")
  arm              ExperimentArm
  /// Как назначена группа: hash — случайно по хешу, участвует в оценке;
  /// experiment-off, excluded-rule, already-shown, dismissed, resolved — вне оценки, всегда treatment.
  assignedBy       String        @map("assigned_by")
  /// Показанная рекомендация; у контроля всегда null.
  recommendationId String?       @map("recommendation_id")
  /// Состояние на момент сигнала: текущий этап связки, программы навыка, доля контроля.
  context          Json?
  /// Когда исход наступил (успех) или окно H дней закрылось без него; null — ещё ждём.
  outcomeAt        DateTime?     @map("outcome_at")
  /// Исход: { state: success | failure, days, event, evaluatedAt }.
  outcome          Json?
  createdAt        DateTime      @default(now()) @map("created_at")

  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  @@unique([ruleType, entityType, entityId, periodKey])
  @@index([firedAt])
  @@index([recommendationId])
  @@index([entityType, entityId])
  @@map("recommendation_signals")
}

model DataSource {
  id             String          @id @default(cuid())
  name           String          @unique
  type           DataSourceType
  url            String?
  collectionDate DateTime?       @map("collection_date")
  reliability    ConfidenceLevel @default(LOW)
  description    String?
  isMock         Boolean         @default(true) @map("is_mock")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  demand MarketDemand[]

  @@map("data_sources")
}

/// Журнал критичных действий (раздел 15 ТЗ). Персональные данные в payload не пишутся.
///
/// Только дописывается и защищён от подмены цепочкой хешей (решение 115, миграция
/// audit_hash_chain). Всё это живёт только в SQL миграции, Prisma о нём не знает:
/// - триггер zz_audit_chain_link (BEFORE INSERT) сам ставит chain_seq, prev_hash
///   и row_hash — значения из приложения перезаписываются;
/// - триггеры audit_log_append_only и audit_log_no_truncate запрещают UPDATE, DELETE
///   и TRUNCATE без `SET LOCAL skilllink.allow_audit_purge = 'on'`;
/// - CHECK audit_log_chain_check: номер и хеш есть у каждой строки.
/// Проверка — функция audit_verify_chain() и независимо modules/audit/chain.rules.ts.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  objectType String   @map("object_type")
  objectId   String   @map("object_id")
  /// Адрес клиента (`payload.address`) в хеш не входит: его стирают по сроку (решение 88).
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  /// Место в цепочке: 1, 2, 3… без пропусков. Ставит триггер под блокировкой.
  chainSeq   BigInt?  @unique @map("chain_seq")
  /// SHA-256 предыдущей строки цепочки; NULL — у первой строки.
  prevHash   Bytes?   @map("prev_hash")
  /// SHA-256 от prev_hash и канонической записи строки (audit_row_canonical).
  rowHash    Bytes?   @map("row_hash")

  /// RESTRICT, а не SET NULL: обнуление автора — правка журнала, и триггер её не пропустит.
  /// Сотрудник не удаляется, а блокируется.
  user User? @relation("AuditLogUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([objectType, objectId])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_log")
}

/// Печать журнала (решение 115): голова цепочки на момент снятия. Только дописывается.
/// Копия печати вне базы (сообщение владельцу) ловит удаление хвоста журнала,
/// которое сама цепочка не видит. Снимает `npm run audit:seal` или audit_take_seal().
model AuditSeal {
  id        BigInt   @id @default(autoincrement())
  /// chain_seq последней строки журнала; 0 — журнал пуст.
  headSeq   BigInt   @map("head_seq")
  /// row_hash этой строки; NULL — журнал пуст.
  headHash  Bytes?   @map("head_hash")
  /// Сколько строк было в журнале (после чистки по сроку меньше headSeq).
  rowCount  BigInt   @map("row_count")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_seals")
}

/// Точка чистки журнала по сроку хранения (решение 115). Только дописывается.
/// Чистка удаляет начало цепочки; отсюда проверка знает, с какого номера и какого
/// хеша цепочка законно начинается. Пишет только функция audit_purge_before().
model AuditChainCut {
  id          BigInt   @id @default(autoincrement())
  /// Номер последней удалённой строки.
  cutSeq      BigInt   @unique @map("cut_seq")
  /// Её row_hash — prev_hash первой оставшейся строки.
  cutHash     Bytes    @map("cut_hash")
  deletedRows BigInt   @map("deleted_rows")
  /// Граница срока хранения, по которой чистили.
  cutoff      DateTime
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_chain_cuts")
}

/// Личная подписка на календарь сроков и встреч (.ics, решение 105).
/// Одна на пользователя. Токен из ссылки в базе не хранится — только SHA-256 от него:
/// утёкшая копия базы не даёт открыть ни одну ленту. Перевыпуск заменяет хеш,
/// отзыв удаляет строку.
model CalendarFeed {
  userId    String   @id @map("user_id")
  /// SHA-256 от токена, шестнадцатеричный (64 знака).
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_feeds")
}

/// Заявка на обучение от вуза: applicationCount программы — сумма её заявок, кроме отменённых и отклонённых.
/// Персональных данных обучающихся не содержит.
/// CHECK в базе: quantity 1–10000.
model Application {
  id           String            @id @default(cuid())
  programId    String            @map("program_id")
  universityId String            @map("university_id")
  source       DataOrigin        @default(MANUAL)
  status       ApplicationStatus @default(NEW)
  /// Количество заявок в одной записи: вуз может внести пакет разом.
  quantity     Int               @default(1)
  comment      String?
  externalRef  String?           @map("external_ref")
  createdById  String?           @map("created_by_id")
  submittedAt  DateTime          @default(now()) @map("submitted_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  program    EducationalProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  university University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdBy  User?              @relation("ApplicationAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([programId])
  @@index([universityId])
  @@index([status])
  @@index([createdById])
  @@map("applications")
}

/// Привязка пользователя к личному чату Telegram (решение 102): туда приходит сводка
/// «что горит у меня». Один пользователь — один чат, один чат — один пользователь.
/// Хранится только то, без чего сообщение не доставить: идентификатор чата и ник,
/// чтобы человек в профиле узнал свой аккаунт. Удаляется вместе с пользователем
/// и командой /stop — истории у привязки нет и не нужно.
model TelegramLink {
  id       String   @id @default(cuid())
  userId   String   @unique @map("user_id")
  /// Идентификатор чата Telegram — целое до 52 бит, хранится строкой: в Int не влезает.
  chatId   String   @unique @map("chat_id")
  username String?
  linkedAt DateTime @default(now()) @map("linked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_links")
}

// ─────────────────── Каналы уведомлений: MAX, VK (решение 144) ───────────────────

/// Каналы уведомлений сотруднику, кроме Telegram (который остаётся в telegram_links,
/// решение 102 — раздельные схемы старше этой модели). MAX и VK — российские сервисы,
/// в отличие от Telegram (docs/PRIVACY.md).
enum NotifyChannelKind {
  TELEGRAM
  MAX
  VK
}

/// Привязка альтернативного канала уведомлений — MAX или VK (решение 144). Тот же
/// принцип, что у Telegram: один пользователь — один чат на канал, один чат — один
/// пользователь; перепривязка заменяет прежнюю запись. Хранится только то, без чего
/// сообщение не доставить: идентификатор чата/собеседника на стороне канала и ник.
model NotificationChannelLink {
  id       String            @id @default(cuid())
  userId   String            @map("user_id")
  channel  NotifyChannelKind
  /// Идентификатор чата/собеседника на стороне канала: MAX — user_id/chat_id, VK — peer_id.
  chatRef  String            @map("chat_ref")
  username String?
  linkedAt DateTime          @default(now()) @map("linked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@unique([channel, chatRef])
  @@map("notification_channel_links")
}

/// Дедупликация входящих обновлений MAX и VK (решение 144) — общей таблицей на оба
/// канала, тем же приёмом, что telegram_updates_seen (решение 133): Telegram обрабатывает
/// свой вебхук отдельно и в этой таблице не участвует.
model ChannelUpdatesSeen {
  channel  NotifyChannelKind
  /// Идентификатор события на стороне канала (MAX update_id, VK event_id) — строкой:
  /// у каналов разный тип идентификатора, общего числового формата нет.
  updateId String            @map("update_id")
  seenAt   DateTime          @default(now()) @map("seen_at")

  @@id([channel, updateId])
  @@index([seenAt])
  @@map("channel_updates_seen")
}

// ─────────────────────── Качество данных (решение 134) ───────────────────────

/// Пара записей, отмеченная «не дубль»: поиск дублей её больше не предлагает.
/// Пара хранится упорядоченной (first_id < second_id) — «A и B» и «B и A» одна запись.
/// Ссылок на сами записи нет: сущности разные (вуз, навык, программа, продукт);
/// исключение про удалённую запись просто ни на что не влияет.
/// CHECK в базе: entity — одна из четырёх; first_id < second_id.
model DuplicateDismissal {
  id            String   @id @default(cuid())
  entity        String
  firstId       String   @map("first_id")
  secondId      String   @map("second_id")
  comment       String?
  dismissedById String   @map("dismissed_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  dismissedBy User @relation("DuplicateDismissalAuthor", fields: [dismissedById], references: [id], onDelete: Restrict)

  @@unique([entity, firstId, secondId])
  @@index([dismissedById])
  @@map("duplicate_dismissals")
}

/// Слияние вуза-дубля в другой (решение 134). Журнал выживания полей и список
/// перенесённых объектов — чтобы слияние можно было объяснить и отменить.
/// В журнале только поля вуза и идентификаторы: ФИО и контакты не копируются.
/// CHECK в базе: source_id <> target_id; отменившего без даты отмены не бывает и наоборот
/// (решение 143 сделал проверку симметричной, миграция 20260926200000_schema_review).
model UniversityMerge {
  id           String    @id @default(cuid())
  sourceId     String    @map("source_id")
  targetId     String    @map("target_id")
  mergedById   String    @map("merged_by_id")
  mergedAt     DateTime  @default(now()) @map("merged_at")
  /// До какого момента слияние можно отменить.
  undoUntil    DateTime  @map("undo_until")
  /// Правила выбора значения по полям: { поле: правило }.
  fieldRules   Json      @map("field_rules")
  /// Журнал выживания: по каждому полю — правило, чьё значение осталось, было и стало.
  survivorship Json
  /// Идентификаторы перенесённых объектов по таблицам — для отмены.
  moved        Json
  /// Состояние цели и источника до слияния — для отмены.
  before       Json
  undoneAt     DateTime? @map("undone_at")
  undoneById   String?   @map("undone_by_id")

  source   University @relation("UniversityMergeSource", fields: [sourceId], references: [id], onDelete: Restrict)
  target   University @relation("UniversityMergeTarget", fields: [targetId], references: [id], onDelete: Restrict)
  mergedBy User       @relation("UniversityMergeAuthor", fields: [mergedById], references: [id], onDelete: Restrict)
  undoneBy User?      @relation("UniversityMergeUndoAuthor", fields: [undoneById], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([targetId])
  @@index([mergedById])
  @@index([undoneById])
  @@map("university_merges")
}

// ─────────────────────── Безопасность, волна 2 (решение 133) ───────────────────────

/// Обработанные обновления Telegram: один update_id выполняется один раз и после
/// перезапуска процесса. Записи старше 7 суток чистятся при вставке и retention-скриптом.
model TelegramUpdateSeen {
  updateId BigInt   @id @map("update_id")
  seenAt   DateTime @default(now()) @map("seen_at")

  @@index([seenAt])
  @@map("telegram_updates_seen")
}

/// Секреты, которые меняются без перезапуска. Два вида записи:
/// - только хеш (секрет вебхука Telegram) — проверке входящего запроса больше не
///   нужно само значение, оно только у Telegram;
/// - зашифрованное значение (решение 142: токен бота Telegram, имя бота, режим
///   приёма) — `value` хранит AES-256-GCM (nonce|tag|ciphertext, base64; ключ —
///   HKDF от AUTH_SECRET) или, для не-секретных настроек вроде имени бота и
///   режима, значение как есть. Запись здесь главнее переменной окружения.
/// CHECK в базе: ровно одно из value_hash/value заполнено; value_hash, если есть, —
/// 64 шестнадцатеричных знака.
model SystemSecret {
  name        String  @id
  valueHash   String? @map("value_hash")
  value       String?
  rotatedAt   DateTime @default(now()) @map("rotated_at")
  rotatedById String?  @map("rotated_by_id")

  rotatedBy User? @relation("SystemSecretRotatedBy", fields: [rotatedById], references: [id], onDelete: SetNull)

  @@index([rotatedById])
  @@map("system_secrets")
}

/// Статус запроса на одобрение опасной операции («четыре глаза»).
enum ApprovalStatus {
  REQUESTED
  APPROVED
  REJECTED
  CONSUMED
  EXPIRED
}

/// Одобрение опасной операции вторым администратором. Одноразовое: использование —
/// атомарный UPDATE … WHERE status = 'APPROVED' AND payload_hash = … AND expires_at > now().
/// CHECK в базе: одобривший ≠ запросившему; APPROVED/CONSUMED — с одобрившим;
/// CONSUMED ровно при consumed_at; REJECTED — с отклонившим; payload_hash — hex SHA-256.
/// Решение 143 (approvals_decided_at_check, миграция 20260926200000_schema_review):
/// decided_at пуст ровно у REQUESTED и заполнен у APPROVED/REJECTED/CONSUMED;
/// EXPIRED — особый случай (просрочиться может и ждущий, и уже одобренный запрос).
model Approval {
  id            String         @id @default(cuid())
  /// Код действия (approvals.rules.ts, APPROVAL_ACTIONS).
  action        String
  /// Параметры действия — только идентификаторы, без ПД. Для экрана одобрения.
  payload       Json
  /// SHA-256 канонического JSON { action, payload }: одобрено ровно это действие.
  payloadHash   String         @map("payload_hash")
  status        ApprovalStatus @default(REQUESTED)
  requestedById String         @map("requested_by_id")
  approvedById  String?        @map("approved_by_id")
  rejectedById  String?        @map("rejected_by_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  decidedAt     DateTime?      @map("decided_at")
  expiresAt     DateTime       @map("expires_at")
  consumedAt    DateTime?      @map("consumed_at")

  requestedBy User  @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User? @relation("ApprovalApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy  User? @relation("ApprovalRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([requestedById])
  @@index([approvedById])
  @@index([rejectedById])
  @@map("approvals")
}

/// Статус ключа идемпотентности.
enum IdempotencyStatus {
  IN_PROGRESS
  SUCCEEDED
}

/// Ключ идемпотентности POST-создания: повтор с тем же ключом и телом отдаёт
/// сохранённый ответ, а не создаёт вторую запись. Живёт 24 часа.
model IdempotencyKey {
  userId         String            @map("user_id")
  key            String
  /// SHA-256 метода, пути и тела запроса.
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// Реестр запросов субъектов ПД (решение 116): кто, о ком, что просил, срок ответа и когда исполнено.
/// Строки не удаляются: приложение только добавляет запрос и закрывает его (роль БД без DELETE,
/// триггер `dsar_requests_guard` не даёт менять неизменяемые колонки). ПД в строке нет, кроме
/// идентификаторов и адреса клиента (`ip`) у запроса из личного кабинета.
/// CHECK в базе: COMPLETED ровно при completed_at; срок позже запроса; исполнение не раньше запроса.
model DsarRequest {
  id            String             @id @default(cuid())
  subjectType   DsarSubjectType    @map("subject_type")
  /// Идентификатор пользователя или контакта. Без внешнего ключа: субъект двух видов.
  subjectId     String             @map("subject_id")
  kind          DsarRequestKind
  channel       DsarRequestChannel
  requestedById String             @map("requested_by_id")
  requestedAt   DateTime           @default(now()) @map("requested_at")
  /// Срок ответа: 10 рабочих дней на сведения (ч. 3 ст. 14), 7 — на уничтожение (ч. 3 ст. 20).
  dueAt         DateTime           @map("due_at")
  completedAt   DateTime?          @map("completed_at")
  status        DsarRequestStatus  @default(OPEN)
  /// Итог исполнения: счётчики по разделам, без самих данных.
  summary       Json?
  /// Адрес клиента — только у запроса из личного кабинета.
  ip            String?

  requestedBy User @relation("DsarRequestAuthor", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([subjectType, subjectId, requestedAt])
  @@index([status, dueAt])
  @@index([requestedById])
  @@map("dsar_requests")
}
