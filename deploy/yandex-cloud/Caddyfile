# Caddy перед приложением SkillLink.
#
# SITE_ADDRESS приходит из .env.cloud:
#   skilllink.example.ru — HTTPS: сертификат Caddy получает и продлевает сам,
#                          http перенаправляется на https;
#   :80                  — без домена: только http по IP-адресу.
#
# Заголовки X-Forwarded-* Caddy выставляет сам и не доверяет тем, что прислал
# клиент, — подделать адрес или протокол снаружи нельзя.

{$SITE_ADDRESS} {
	encode zstd gzip

	# Журнал запросов: кто, когда, куда и с каким ответом — без него разбор
	# инцидента (подбор пароля, выгрузка базы) держится только на журнале
	# приложения. Файл в томе caddy-data, ротация по 10 МБ, пять архивов и не
	# дольше 30 суток: IP-адрес — персональные данные, срок хранения записан
	# в docs/PRIVACY.md. Cookie и Authorization Caddy в журнал не пишет сам.
	#
	# Из адреса запроса вырезается `q` — строка поиска и фильтр выгрузки:
	# в ней бывает фамилия контактного лица.
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>uri query {
					delete q
				}
			}
		}
	}

	# Лента календаря не пишется в журнал запросов вовсе: токен подписки — часть
	# адреса (/api/calendar/<токен>.ics), а кто знает адрес, тот читает ленту.
	# Вырезать его фильтром нельзя — у поля адреса уже есть фильтр `q`
	# (решение 105).
	@calendarFeed path /api/calendar/*
	log_skip @calendarFeed

	# Не сообщать, на чём работает сервер: заголовок Server — подсказка для
	# подбора известных уязвимостей и больше ни для чего.
	header -Server

	# HSTS: браузер больше не пойдёт на сайт по http. Для адреса без HTTPS
	# заголовок браузеры игнорируют — вреда нет.
	header Strict-Transport-Security "max-age=31536000"

	# Страницы и ответы API не кэшируются браузером без проверки.
	#
	# Next отдаёт готовые страницы с `s-maxage=31536000`. Этот заголовок
	# предназначен промежуточным кэшам, но браузер, не увидев `max-age`,
	# начинает кэшировать по своему усмотрению — и показывает вчерашнюю
	# версию сайта. Так и случилось: после выкладки интерфейса Safari
	# продолжал показывать старую заглушку.
	#
	# `no-cache` не запрещает хранить, а требует спросить сервер перед показом.
	# С ETag это дешёвый ответ 304, зато никто не видит устаревший стенд.
	@page not path /_next/static/* /_next/image*
	header @page Cache-Control "no-cache"

	# Собранные файлы имеют хеш в имени: их можно держать вечно.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy app:3000
}
