# Настройки стенда в Yandex Cloud (deploy/yandex-cloud/compose.cloud.yml) — только
# на сервере, в ~/skilllink/.env.cloud. В git не попадает (тот файл — с реальными
# секретами). Обязательные секреты (пароль базы, секрет подписи сессий, пароль
# демо-пользователей, адрес сайта) scripts/deploy/deploy.sh создаёт и вписывает сам
# при первом развёртывании — руками их заводить не нужно (docs/DEPLOY.md).
#
# Этот файл — только опись: что вообще можно задать сверх сгенерированного,
# и в каком формате. Сверяется тестом src/shared/config/deploy-consistency.test.ts
# с тем, что читает docker-compose.yml + compose.cloud.yml.

# ── Заводятся развёртыванием (scripts/deploy/deploy.sh) — здесь для справки ──
POSTGRES_PASSWORD=""
DOCKER_AUTH_SECRET=""
SEED_DEMO_PASSWORD=""
DOCKER_DEMO_AUTH_ENABLED="false"
SITE_ADDRESS=""
DOCKER_AUTH_URL=""

# ── Ключ HMAC для заказов с сайта в контейнере (решение 132) — необязателен,
# по умолчанию выводится из AUTH_SECRET; в приложении та же настройка называется
# ORDERS_HMAC_KEY (.env.example) ──
# DOCKER_ORDERS_HMAC_KEY=""

# ── Приём данных извне: сайт и LMS (решение 145) — тот же смысл, что в .env.example;
# пусто — POST /api/import/external отвечает 503 «интеграция не настроена» ──
# INTEGRATION_TOKEN=""

# ── Порт базы наружу контейнера (тот же смысл, что POSTGRES_PORT в .env.example) ──
# POSTGRES_PORT="5432"
# APP_PORT="3000"
# HTTP_PORT="80"
# HTTPS_PORT="443"

# ── Роль базы для приложения без прав суперпользователя (docs/DEPLOY.md) ────
# APP_DATABASE_URL=""

# ── Реквизиты оператора ПД для выгрузки «всё о субъекте» (решение 116/139) —
# тот же смысл, что в .env.example; без них — заглушка «ИТ-Школа РТК (реквизиты
# указываются при внедрении)», система работает и без них ──
# OPERATOR_NAME=""
# OPERATOR_ADDRESS=""
# OPERATOR_CONTACT=""

# ── Источник рыночных данных, интеграции, ИИ-помощник, Telegram — тот же смысл,
# что в .env.example; здесь не дублируется описание, только имена ──
# MARKET_DATA_PROVIDER="mock"
# LMS_ENABLED="false"
# SITE_ENABLED="false"
# AI_ASSIST_PROVIDER=""
# AI_ASSIST_TIMEOUT_MS=""
# YANDEX_GPT_API_KEY=""
# YANDEX_FOLDER_ID=""
# YANDEX_GPT_MODEL=""
# GIGACHAT_AUTH_KEY=""
# GIGACHAT_SCOPE=""
# GIGACHAT_MODEL=""
# GIGACHAT_CA_CERT_PATH=""
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_BOT_USERNAME=""
# TELEGRAM_WEBHOOK_SECRET=""
# TELEGRAM_API_BASE=""
# TELEGRAM_API_IP=""
# Каналы уведомлений: MAX и VK (решение 144) — оба без токена на этом хакатоне, «для галочки».
# MAX_BOT_TOKEN=""
# MAX_BOT_USERNAME=""
# MAX_WEBHOOK_SECRET=""
# MAX_API_BASE=""
# VK_GROUP_TOKEN=""
# VK_GROUP_ID=""
# VK_CONFIRMATION_CODE=""
# VK_SECRET=""
# VK_API_VERSION=""
# VK_API_BASE=""

# ── Заморозка после сдачи (решение 147, docs/DEPLOY.md, «Заморозка после сдачи») —
# читают напрямую scripts/ops/watchdog.sh и scripts/ops/restore-drill.sh (env_get),
# не через docker-compose. Момент сдачи, ISO 8601 со смещением; пусто — не заморожено.
# Раскомментировать и вписать дату вечером 29.09.2026 (до 23:59 МСК):
# STAND_FREEZE_AT="2026-09-29T23:59:00+03:00"
