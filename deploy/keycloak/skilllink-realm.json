{
  "realm": "skilllink",
  "displayName": "SkillLink",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "permanentLockout": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 28800,

  "clients": [
    {
      "clientId": "skilllink-web",
      "name": "SkillLink (веб-приложение)",
      "description": "Единый вход SkillLink через Keycloak (ТЗ, функц. 10; решение 188). Секрет клиента НЕ хранится здесь — задаётся отдельно scripts/deploy/keycloak-users.sh после старта контейнера, из переменной окружения KEYCLOAK_CLIENT_SECRET.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "https://skilllink.site/api/auth/callback/keycloak",
        "http://localhost:3000/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "https://skilllink.site",
        "http://localhost:3000"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://skilllink.site/login##http://localhost:3000/login"
      }
    }
  ],

