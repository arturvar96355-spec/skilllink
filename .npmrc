# Несовместимая версия Node должна останавливать установку, а не всплывать позже.
#
# Prisma 7 не работает на 20.0–20.18, 21.x и 22.0–22.11: это не «старый Node»,
# а дыры между поддерживаемыми ветками. Без этой настройки npm ограничился бы
# предупреждением в потоке вывода, а ошибка вылезла бы при первом запросе к базе —
# и выглядела бы как поломка проекта, а не как неподходящая версия.
engine-strict=true
