# ─── База данных ────────────────────────────────────────────────────────────
# Локально: docker compose up -d  либо brew services start postgresql@16
DATABASE_URL="postgresql://skilllink:skilllink@localhost:5432/skilllink?schema=public"

# ─── Приложение ─────────────────────────────────────────────────────────────
APP_BASE_URL="http://localhost:3000"

# ─── Источник рыночных данных (решение 12) ──────────────────────────────────
# mock | csv | external-api | future-rtk
MARKET_DATA_PROVIDER="mock"
MARKET_DATA_CSV_PATH=""
MARKET_DATA_API_URL=""
MARKET_DATA_API_TOKEN=""

# ─── Интеграции: по умолчанию выключены (решение 13) ────────────────────────
LMS_ENABLED="false"
LMS_API_URL=""
LMS_API_TOKEN=""

SITE_ENABLED="false"
SITE_API_URL=""
SITE_API_TOKEN=""

# Таймаут и повторы для внешних вызовов
INTEGRATION_TIMEOUT_MS="5000"
INTEGRATION_RETRIES="2"
