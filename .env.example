# ─── База данных ────────────────────────────────────────────────────────────
# Локально: docker compose up -d  либо brew services start postgresql@16
DATABASE_URL="postgresql://skilllink:skilllink@localhost:5432/skilllink?schema=public"

# Только для docker-compose.yml (сервис postgres) — не читает само приложение,
# оно ходит по DATABASE_URL выше. Пусто — skilllink/skilllink/skilllink/5432.
# POSTGRES_USER="skilllink"
# POSTGRES_PASSWORD="skilllink"
# POSTGRES_DB="skilllink"
# POSTGRES_PORT="5432"

# ─── Приложение ─────────────────────────────────────────────────────────────
# Порт сервера. Его читает сам Next.js при запуске (next start, сервер standalone-сборки).
PORT="3000"
APP_BASE_URL="http://localhost:3000"

# ─── Аутентификация ─────────────────────────────────────────────────────────
# Секрет подписи JWT. Обязателен в продакшене — без него приложение не стартует.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Публичный адрес приложения — только если перед ним стоит прокси (nginx, Caddy)
# и сайт открывают по другому адресу, чем слушает сервер. Без него после входа
# NextAuth отправит пользователя на https://localhost:<порт>: Next.js собирает адрес
# запроса из собственного имени, а не из заголовка Host. Локально не нужен.
# AUTH_URL="https://skilllink.example"

# Демо-режим: вход без пароля по cookie skilllink_user и пользователь по умолчанию.
# Включён везде, кроме продакшена. В промышленном контуре держать false.
DEMO_AUTH_ENABLED="true"

# Только для проверки пробником (npm run probe), и только в демо-режиме: запросы
# с заголовком X-Rate-Limit-Test получают свой счёт с этим низким пределом,
# чтобы проверить ответ 429 без тысяч запросов (решение 117). Без демо-режима
# не действует. Пусто — выключено.
# RATE_LIMIT_TEST_OVERRIDE="5"

# ─── Источник рыночных данных (решение 12) ──────────────────────────────────
# mock | csv | external-api | future-rtk
MARKET_DATA_PROVIDER="mock"
# В Windows пишите прямые слэши: C:/data/market.csv — обратные теряются при чтении.
MARKET_DATA_CSV_PATH=""
MARKET_DATA_API_URL=""
MARKET_DATA_API_TOKEN=""

# ─── Интеграции: по умолчанию выключены (решение 13) ────────────────────────
LMS_ENABLED="false"
LMS_API_URL=""
LMS_API_TOKEN=""

SITE_ENABLED="false"
SITE_API_URL=""
SITE_API_TOKEN=""

# Таймаут и повторы для внешних вызовов
INTEGRATION_TIMEOUT_MS="5000"
INTEGRATION_RETRIES="2"
# Минимальный интервал между запросами к одному внешнему сервису, мс.
# Защищает чужой сервис от нашей частоты, а не наш — от чужой.
INTEGRATION_MIN_INTERVAL_MS="200"

# ─── ИИ-помощник (решение 90): черновики текста по фактам правил ─────────────
# off | yandexgpt | gigachat. Пусто — off: помощник пишет тот же текст
# шаблоном, модель не вызывается. Модель ничего не решает — только формулирует
# факты, посчитанные правилами. Персональные данные в неё не уходят.
# Как подключить — docs/DEPLOY.md, раздел «Как подключить YandexGPT».
AI_ASSIST_PROVIDER=""
# Таймаут ответа модели, мс; пусто — 15000. Не уложилась — шаблон, повторов нет.
AI_ASSIST_TIMEOUT_MS=""

# YandexGPT (Yandex Foundation Models) — основной. API-ключ сервисного аккаунта
# с ролью ai.languageModels.user и идентификатор каталога Yandex Cloud.
YANDEX_GPT_API_KEY=""
YANDEX_FOLDER_ID=""
# Модель: пусто — yandexgpt-lite (дешевле и быстрее); можно yandexgpt.
YANDEX_GPT_MODEL=""

# GigaChat — запасной российский. Ключ авторизации (Base64 из личного кабинета
# Studio), область доступа (пусто — GIGACHAT_API_PERS) и модель (пусто — GigaChat).
GIGACHAT_AUTH_KEY=""
GIGACHAT_SCOPE=""
GIGACHAT_MODEL=""
# Путь к сертификату НУЦ Минцифры (russian_trusted_root_ca.pem): без него
# TLS до GigaChat не проходит.
GIGACHAT_CA_CERT_PATH=""

# ─── Уведомления в Telegram (решение 102): сводка «что горит у меня» ────────
# По умолчанию выключены: пока пусты токен, имя бота или секрет вебхука, личный
# кабинет пишет «Не настроено администратором», а приложение работает как раньше.
# Как подключить — docs/SETUP.md, раздел «Бот уведомлений в Telegram».
# Токен бота от @BotFather (/newbot). Секрет: только здесь, в git и в чаты — нет.
TELEGRAM_BOT_TOKEN=""
# Имя бота без @ (например skilllink_notify_bot) — для ссылки t.me/<имя>?start=…
TELEGRAM_BOT_USERNAME=""
# Секрет вебхука: то же значение, что в setWebhook(secret_token=…). Telegram
# присылает его в заголовке X-Telegram-Bot-Api-Secret-Token; без него — 403.
# 1–256 символов A–Z, a–z, 0–9, _ и -. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=""
# База Bot API; пусто — https://api.telegram.org. Локальная заглушка — http://…
TELEGRAM_API_BASE=""
# IP, на который соединяться вместо DNS-имени из TELEGRAM_API_BASE. Из Yandex
# Cloud api.telegram.org по имени не отвечает, по запасному IP — отвечает:
# TELEGRAM_API_IP="149.154.167.220". TLS-имя (SNI) и Host остаются api.telegram.org,
# сертификат проверяется как обычно. Пусто — обычный DNS.
TELEGRAM_API_IP=""
# Оповещения владельцу (решение 118): приложение шлёт в Telegram события безопасности
# (блокировка входа, вход администратора с нового адреса, блокировка пользователя,
# выдача роли администратора, массовая выгрузка) всем активным администраторам
# с привязанным ботом — и, если задан, ещё в этот чат. Скрипты сервера
# (scripts/ops/alert.sh, сторож) читают его из .env.cloud так же. Узнать id чата:
# написать боту и открыть https://api.telegram.org/bot<токен>/getUpdates.
TELEGRAM_OWNER_CHAT_ID=""

# ── Заказы с сайта → файл для LMS (решение 132) ─────────────────────────────
# Ключ HMAC для почты и телефона слушателей: в базе хранятся только хеши
# (site_orders.email_hash, phone_hash), сами адреса — нет. Без ключа хеш почты
# перебирается по словарю адресов; ключ лежит вне базы. Обязателен в продакшене
# (не короче 32 знаков), локально пусто — встроенный ключ разработки.
# Сменить ключ = потерять сравнение с прошлыми загрузками (docs/PRIVACY.md, раздел 9).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ORDERS_HMAC_KEY=""
# В контейнере (docker-compose.yml) читается как DOCKER_ORDERS_HMAC_KEY — задать
# на сервере в .env.cloud тем же способом, что и остальные секреты (docs/DEPLOY.md).
# DOCKER_ORDERS_HMAC_KEY=""
# ── Безопасность, волна 2 (решение 133) ──────────────────────────────────────
# «Четыре глаза»: назначение роли ADMIN и блокировка администратора требуют
# одобрения другого администратора. По умолчанию выключено — не ломает демо-сценарий
# с одним администратором. Включайте в промышленном контуре и в тестах.
# APPROVALS_REQUIRED="true"
# Строгий режим контактов: почта и телефон контактного лица вуза не приходят
# в карточке никому — только маски и раскрытие по причине (POST /api/contacts/:id/reveal).
# По умолчанию выключено — карточка отдаёт значения как раньше (решение 106).
# CONTACT_REVEAL_REQUIRED="true"

# ── Демонстрационные данные (npm run db:seed) ───────────────────────────────
# Пароль всех демо-пользователей. По умолчанию «skilllink» — он записан
# в документации, поэтому на стенде с публичным адресом задавайте свой.
# SEED_DEMO_PASSWORD=""
# До какой даты демо-набор не «протухает» (решение 121): будущие сроки, встречи
# и следующие шаги сдвигаются за неё, прошедшие остаются на месте. ISO-дата.
# По умолчанию 2026-10-15T21:00:00Z (16.10 00:00 МСК): конец экспертизы 14.10 и сутки запаса.
# SEED_STABLE_UNTIL=""

# ── Только для скриптов проверки, в приложении не используются ───────────────
# npm run volume — размер наполнения отдельной базы
# VOLUME_UNIVERSITIES="120"
# VOLUME_PROGRAMS="4"
# VOLUME_COOPERATIONS="3"
# npm run bench — против какого адреса замерять и сколько прогонов
# BENCH_BASE_URL="http://localhost:3000"
# BENCH_RUNS="7"

# ─── Метрики сервера (решение 137) ──────────────────────────────────────────
# Токен для GET /api/metrics: заголовок Authorization: Bearer <токен>. Пусто —
# читать метрики может только сама машина приложения (docker exec, next start
# локально); снаружи адрес и так закрыт в Caddy. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
METRICS_TOKEN=""

# Отметка последней удачной ночной копии (JSON вида {"timestamp":…,"sizeBytes":…}),
# которую пишет crontab-строка из docs/DEPLOY.md. Пусто — метрик копии нет вовсе
# (разработка, CI), а не «копии нет» с нулями.
BACKUP_STATUS_FILE=""

# Короткий хеш коммита работающей сборки — для app_build_info. Задаёт развёртывание
# (scripts/deploy/remote-up.sh), не человек. Пусто — unknown.
# APP_COMMIT=""

# Профиль docker-compose `monitoring` (Prometheus + Grafana, deploy/monitoring/README.md).
# Не читает приложение — только docker-compose.yml. По умолчанию выключен, включает
# владелец сам: docker compose --profile app --profile monitoring up -d.
# GRAFANA_ADMIN_PASSWORD обязателен для этого профиля — без него compose откажется
# стартовать (иначе Grafana поднялась бы с admin/admin).
# GRAFANA_ADMIN_PASSWORD=""
# PROMETHEUS_PORT="9090"
# GRAFANA_PORT="3001"

# ── Копии базы вне сервера (решение 114): только в ~/skilllink/.env.cloud на сервере ──
# Приложение их не читает — читают scripts/deploy/backup-offsite.sh и restore-offsite.sh.
# Где взять и как дописать со скрытым вводом — docs/DEPLOY.md, «Копии вне сервера».
# Имя приватного бакета Yandex Object Storage.
# YC_S3_BUCKET=""
# Статический ключ доступа сервисного аккаунта с ролью storage.uploader на этот бакет:
# идентификатор и секретный ключ. Секрет консоль показывает один раз.
# YC_S3_ACCESS_KEY_ID=""
# YC_S3_SECRET_ACCESS_KEY=""
# Пароль шифрования копий, не короче 20 символов: openssl rand -base64 32.
# Храните его и вне сервера (менеджер паролей) — без него копии не расшифровать.
# BACKUP_ENCRYPTION_PASSPHRASE=""

# ── Адрес и порты стенда: ~/skilllink/.env.cloud на сервере (решение 118) ───────
# Их пишет deploy.sh (адрес) или задают по умолчанию compose-файлы (порты). Здесь —
# чтобы знать, что их читают и скрипты сервера: проверка после выкладки
# (scripts/deploy/remote-up.sh) и сторож (scripts/ops/watchdog.sh) стучатся по ним
# в приложение и в Caddy на той же машине.
# Домен для Caddy или «:80» — без домена, только http.
# SITE_ADDRESS=""
# Публичный адрес стенда (https://<домен>): по нему NextAuth строит переходы.
# DOCKER_AUTH_URL=""
# Порты: приложение на 127.0.0.1 (3000), Caddy — 80 и 443.
# APP_PORT=""
# HTTP_PORT=""
# HTTPS_PORT=""
