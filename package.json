{
  "name": "skilllink",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:docs": "vitest run src/shared/openapi/docs-counts.test.ts src/shared/openapi/doc-links.test.ts src/shared/openapi/contract-coverage.test.ts src/shared/config/env-coverage.test.ts src/shared/config/compose-docs.test.ts src/shared/config/engines.test.ts src/ui/design-tokens.test.ts src/shared/db/schema-constraints.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "smoke": "tsx scripts/smoke.ts",
    "openapi": "tsx scripts/openapi.ts",
    "probe": "tsx scripts/probe.ts",
    "volume": "tsx scripts/volume.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:retention": "tsx scripts/retention.ts",
    "telegram:digest": "tsx scripts/telegram-digest.ts",
    "bench": "tsx scripts/bench.ts",
    "demo:check": "tsx scripts/demo-check.ts",
    "analytics:report": "tsx scripts/analytics-report.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "motion": "^13.4.2",
    "next": "^15.5.25",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "dotenv": "^18.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "@prisma/client@7.10.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "prisma": {
      "mysql2": "^3.24.4"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "next": {
      "postcss": "^8.5.28"
    }
  }
}
