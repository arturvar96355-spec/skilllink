<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="SkillLink — архитектура решения" id="id-skilllink-model" version="5.0.0">
<folder name="Strategy" id="fld-strategy" type="strategy"></folder>
<folder name="Business" id="fld-business" type="business"><element xsi:type="archimate:BusinessActor" name="Менеджер по вузам" id="id-ba-manager"></element><element xsi:type="archimate:BusinessActor" name="Руководитель" id="id-ba-lead"></element><element xsi:type="archimate:BusinessActor" name="Администратор платформы" id="id-ba-admin"></element><element xsi:type="archimate:BusinessActor" name="Представитель вуза" id="id-ba-rep"></element><element xsi:type="archimate:BusinessProcess" name="Привлечение" id="id-bp-attract"></element><element xsi:type="archimate:BusinessProcess" name="Оформление" id="id-bp-formalize"></element><element xsi:type="archimate:BusinessProcess" name="Внедрение" id="id-bp-implement"></element><element xsi:type="archimate:BusinessProcess" name="Эксплуатация" id="id-bp-operate"></element><element xsi:type="archimate:BusinessObject" name="Связка вуз-программа-продукт" id="id-bo-cooperation"></element><element xsi:type="archimate:BusinessObject" name="Этап workflow" id="id-bo-stage"></element><element xsi:type="archimate:BusinessObject" name="Документ" id="id-bo-document"></element><element xsi:type="archimate:BusinessObject" name="Рекомендация" id="id-bo-recommendation"></element><element xsi:type="archimate:BusinessObject" name="Рейтинг программы" id="id-bo-rating"></element><element xsi:type="archimate:BusinessService" name="Ведение сотрудничества с вузами" id="id-bs-cooperation"></element><element xsi:type="archimate:BusinessService" name="Формирование отчётности" id="id-bs-reporting"></element><element xsi:type="archimate:BusinessService" name="Аналитика рынка труда и навыков" id="id-bs-analytics"></element></folder>
<folder name="Application" id="fld-application" type="application"><element xsi:type="archimate:ApplicationComponent" name="Веб-интерфейс" id="id-ac-webui"></element><element xsi:type="archimate:ApplicationComponent" name="API-слой" id="id-ac-api"></element><element xsi:type="archimate:ApplicationComponent" name="Сервис Workflow" id="id-ac-workflow"></element><element xsi:type="archimate:ApplicationComponent" name="Сервис Рекомендаций" id="id-ac-recommend"></element><element xsi:type="archimate:ApplicationComponent" name="Сервис Аналитики" id="id-ac-analytics"></element><element xsi:type="archimate:ApplicationComponent" name="Сервис Документов" id="id-ac-documents"></element><element xsi:type="archimate:ApplicationComponent" name="Сервис Пользователей и Прав" id="id-ac-users"></element><element xsi:type="archimate:ApplicationComponent" name="Сервис Журнала действий" id="id-ac-audit"></element><element xsi:type="archimate:ApplicationComponent" name="ИИ-помощник" id="id-ac-ai"></element><element xsi:type="archimate:ApplicationComponent" name="Сервис Импорта/Экспорта" id="id-ac-io"></element><element xsi:type="archimate:ApplicationComponent" name="Telegram-бот уведомлений" id="id-ac-telegram"><documentation>Канал уведомлений пользователей о событиях workflow (новые этапы, документы, напоминания).</documentation></element><element xsi:type="archimate:ApplicationComponent" name="YandexGPT (внешний сервис ИИ)" id="id-ac-yandexgpt"><documentation>Внешний облачный сервис большой языковой модели, используется ИИ-помощником для генерации рекомендаций и ответов. Не входит в периметр разработки SkillLink.</documentation></element><element xsi:type="archimate:ApplicationService" name="Управление связками" id="id-as-cooperation"></element><element xsi:type="archimate:ApplicationService" name="Формирование рекомендаций" id="id-as-recommend"></element><element xsi:type="archimate:ApplicationService" name="Расчёт рейтинга программ" id="id-as-rating"></element><element xsi:type="archimate:ApplicationService" name="Аутентификация и авторизация" id="id-as-auth"></element><element xsi:type="archimate:ApplicationService" name="Генерация отчётов" id="id-as-reports"></element><element xsi:type="archimate:ApplicationInterface" name="REST API" id="id-ai-restapi"></element><element xsi:type="archimate:ApplicationInterface" name="POST /api/import/external" id="id-ai-import"><documentation>Точка приёма данных из внешних систем (импорт вузов/программ извне).</documentation></element><element xsi:type="archimate:DataObject" name="Вуз" id="id-do-university"></element><element xsi:type="archimate:DataObject" name="Программа" id="id-do-program"></element><element xsi:type="archimate:DataObject" name="IT-продукт" id="id-do-product"></element><element xsi:type="archimate:DataObject" name="Связка" id="id-do-cooperation"></element><element xsi:type="archimate:DataObject" name="Этап" id="id-do-stage"></element><element xsi:type="archimate:DataObject" name="Документ" id="id-do-document"></element><element xsi:type="archimate:DataObject" name="Рекомендация" id="id-do-recommendation"></element><element xsi:type="archimate:DataObject" name="Пользователь" id="id-do-user"></element><element xsi:type="archimate:DataObject" name="Журнал действий" id="id-do-auditlog"></element><element xsi:type="archimate:DataObject" name="Файл" id="id-do-file"><documentation>Файл, прикреплённый к документу или этапу сотрудничества (хранится в файловом хранилище на сервере).</documentation></element></folder>
<folder name="Technology &amp; Physical" id="fld-technology" type="technology"><element xsi:type="archimate:Node" name="Сервер приложения (Docker)" id="id-nd-appserver"></element><element xsi:type="archimate:Node" name="Сервер базы данных (Docker)" id="id-nd-dbserver"></element><element xsi:type="archimate:Node" name="Обратный прокси (Caddy)" id="id-nd-proxy"></element><element xsi:type="archimate:SystemSoftware" name="Node.js Runtime" id="id-ss-node"></element><element xsi:type="archimate:SystemSoftware" name="PostgreSQL Server" id="id-ss-postgres"></element><element xsi:type="archimate:TechnologyService" name="Хранение данных" id="id-ts-storage"></element><element xsi:type="archimate:TechnologyService" name="HTTPS-терминация и маршрутизация" id="id-ts-https"></element><element xsi:type="archimate:TechnologyService" name="Файловое хранилище (сервер)" id="id-ts-files"><documentation>Локальное файловое хранилище на сервере приложения для файлов документов и этапов.</documentation></element><element xsi:type="archimate:Artifact" name="Docker-образ приложения" id="id-art-image"></element><element xsi:type="archimate:Artifact" name="Файл отчёта (CSV/XLSX/JSON)" id="id-art-report"><documentation>Выгрузка отчёта по ТЗ в одном из форматов CSV, XLSX или JSON.</documentation></element></folder>
